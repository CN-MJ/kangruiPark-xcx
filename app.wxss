/**app.wxss**/
page {
  background: #f4f6f8;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

.page-wrap {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 35, 95, 0.12), 0 2rpx 8rpx rgba(15, 35, 95, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-of-type {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 输入框外层容器，避免文字/placeholder 被裁切 */
.form-field {
  width: 100%;
  min-height: 88rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.form-field-textarea {
  align-items: flex-start;
  padding: 20rpx 24rpx;
  min-height: 200rpx;
}

.form-input {
  flex: 1;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  padding: 0;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  background: transparent;
  padding: 0;
}

.form-picker {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #333;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.form-picker.placeholder {
  color: #bbb;
}

.form-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

/* 统一按钮（使用 view，避免原生 button 文字偏移） */
.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-btn-primary {
  margin-top: 32rpx;
  background: #3b66f5;
}

.action-btn-plain {
  background: #fff;
  border: 2rpx solid #3b66f5;
}

.action-btn-ghost {
  margin-top: 16rpx;
  height: 80rpx;
  background: transparent;
}

.action-btn.is-loading,
.action-btn-primary.is-loading {
  opacity: 0.75;
}

.action-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  color: #fff;
}

.action-btn-text.plain {
  color: #3b66f5;
}

.action-btn-text.ghost {
  font-size: 26rpx;
  font-weight: 400;
  color: #999;
}

.action-btn-spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: action-btn-spin 0.8s linear infinite;
}

@keyframes action-btn-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.action-btn-sm {
  width: auto;
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
}

.action-btn-sm.danger {
  background: #fff1f0;
}

.action-btn-sm.success {
  background: #f6ffed;
}

.action-btn-sm-text {
  font-size: 24rpx;
  line-height: 1;
  color: #3b66f5;
}

.action-btn-sm-text.danger {
  color: #cf1322;
}

.action-btn-sm-text.success {
  color: #52c41a;
}

.action-btn-sm-wrap {
  margin-top: 16rpx;
}

/* 兼容旧类名（勿再使用原生 button） */
.btn-primary,
.btn-plain {
  display: none;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.list-item:last-child {
  border-bottom: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
  color: #666;
}

.tag-active {
  background: rgba(59, 102, 245, 0.1);
  color: #3b66f5;
}

.tag-cancelled {
  background: #fff1f0;
  color: #cf1322;
}
