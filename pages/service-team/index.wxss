.st-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: #f2f5fa;
  box-sizing: border-box;
}

.st-head {
  margin-bottom: 24rpx;
}

.st-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.st-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.st-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.st-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 40, 100, 0.08);
}

.st-photo {
  width: 100%;
  height: 280rpx;
  background: #e2e8f0;
  display: block;
}

.st-info {
  padding: 18rpx 18rpx 22rpx;
}

.st-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.st-role {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #003791;
}

.st-phone {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.st-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.press-scale {
  opacity: 0.92;
  transform: scale(0.99);
}
