.vehicles-page {
  min-height: 100vh;
  background: var(--bg-page);
}

.bind-tip {
  display: block;
  margin: -8rpx 0 20rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.section-title {
  margin: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c2b2a;
}

.vehicle-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vehicle-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.vehicle-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vehicle-plate {
  font-size: 34rpx;
  font-weight: 700;
  color: #0047b3;
  letter-spacing: 2rpx;
}

.vehicle-tag {
  font-size: 20rpx;
  color: #0047b3;
  background: #eef3fb;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.vehicle-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.vehicle-action {
  font-size: 24rpx;
  color: #0047b3;
}

.vehicle-action.danger {
  color: #dc2626;
}

.vehicle-empty,
.park-loading {
  text-align: center;
  padding: 60rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
