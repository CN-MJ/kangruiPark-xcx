.intro-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.intro-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.service-item {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.service-dot {
  color: #3b66f5;
  margin-right: 8rpx;
}

.service-text {
  font-size: 28rpx;
  color: #333;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx;
}
