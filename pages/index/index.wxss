page {
  --primary: #0f766e;
  --primary-light: #14b8a6;
  --primary-dark: #115e59;
  --accent: #d97706;
  --bg-page: #f4f7f6;
  --bg-card: #ffffff;
  --text-primary: #1c2b2a;
  --text-secondary: #5f6f6e;
  --radius-lg: 24rpx;
  --shadow-card: 0 8rpx 32rpx rgba(15, 118, 110, 0.08);
}

.home-page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

.home-header {
  background: linear-gradient(135deg, #115e59 0%, #0f766e 55%, #14b8a6 100%);
  padding: 16rpx 32rpx 48rpx;
}

.home-header-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 12rpx;
}

.home-greeting {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.home-title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.home-date {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.home-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #115e59;
  background: rgba(255, 255, 255, 0.92);
  font-weight: 600;
}

.home-scroll {
  flex: 1;
  height: 0;
  margin-top: -24rpx;
}

.home-body {
  padding: 0 24rpx;
}

.core-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.core-card {
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  min-height: 200rpx;
  box-shadow: var(--shadow-card);
}

.core-card--teal {
  background: linear-gradient(145deg, #ecfdf5 0%, #d1fae5 100%);
  border: 1rpx solid rgba(15, 118, 110, 0.12);
}

.core-card--green {
  background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%);
  border: 1rpx solid rgba(22, 163, 74, 0.12);
}

.core-card--amber {
  background: linear-gradient(145deg, #fffbeb 0%, #fef3c7 100%);
  border: 1rpx solid rgba(217, 119, 6, 0.12);
}

.core-card:first-child {
  grid-column: 1 / -1;
  min-height: 160rpx;
}

.core-icon {
  display: flex;
  align-items: center;
  line-height: 1;
}

.core-title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.core-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.parking-panel {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid var(--primary);
}

.parking-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.parking-panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.parking-panel-status {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--primary);
}

.parking-panel-link {
  font-size: 24rpx;
  color: var(--primary);
}

.parking-panel-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-dot {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 32rpx;
}

.pending-strip {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border-left: 6rpx solid #0f766e;
}

.pending-strip-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pending-strip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.pending-strip-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 32rpx;
}

.pending-strip-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.pending-strip-plate {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2b2a;
}

.pending-strip-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.parking-panel-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.parking-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.parking-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.parking-stat-num.muted {
  font-size: 36rpx;
  color: #64748b;
}

.parking-stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.parking-progress {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 999rpx;
  overflow: hidden;
}

.parking-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.notice-panel {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.notice-panel-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.notice-panel-swiper {
  flex: 1;
  height: 40rpx;
  margin-left: 16rpx;
}

.notice-panel-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-block {
  margin-bottom: 24rpx;
}

.section-block--last {
  margin-bottom: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

.quick-scroll {
  white-space: nowrap;
}

.quick-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.quick-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}

.quick-chip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.quick-chip-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-primary);
}

.news-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.news-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f4;
}

.news-row:last-child {
  border-bottom: none;
}

.news-row-main {
  flex: 1;
  min-width: 0;
}

.news-row-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-row-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.news-row-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: var(--accent);
  background: #fffbeb;
  border-radius: 8rpx;
}

.news-empty {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-card);
}

.safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.press-scale {
  opacity: 0.88;
  transform: scale(0.98);
}
