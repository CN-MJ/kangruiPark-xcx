/* ===== 设计变量 ===== */
page {
  --primary: #3b66f5;
  --primary-dark: #2f57e8;
  --primary-light: #5b8cff;
  --text-primary: #1a1a1a;
  --text-regular: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --text-disabled: #bbbbbb;
  --bg-page: #f4f6f8;
  --bg-card: #ffffff;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --shadow-card: 0 8rpx 28rpx rgba(15, 35, 95, 0.12), 0 2rpx 8rpx rgba(15, 35, 95, 0.06);
  --shadow-soft: 0 6rpx 22rpx rgba(15, 35, 95, 0.1), 0 2rpx 6rpx rgba(15, 35, 95, 0.05);
}

.page {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* ===== 顶部蓝色区域 ===== */
.header {
  position: relative;
  background: linear-gradient(165deg, #5588ff 0%, var(--primary) 48%, var(--primary-dark) 100%);
  padding: 0 32rpx 72rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.header::before,
.header::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  pointer-events: none;
}

.header::before {
  width: 320rpx;
  height: 320rpx;
  top: -120rpx;
  right: -80rpx;
}

.header::after {
  width: 200rpx;
  height: 200rpx;
  bottom: 20rpx;
  left: -60rpx;
}

.header-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 8rpx 0 40rpx;
}

.header-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
}

.header-location {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.location-row {
  display: flex;
  align-items: center;
}

.location-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.location-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}

.location-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 快捷入口 */
.quick-actions {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 4rpx 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.quick-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(20, 50, 140, 0.18), 0 2rpx 8rpx rgba(20, 50, 140, 0.08);
}

.quick-icon {
  font-size: 42rpx;
  line-height: 1;
}

.quick-label {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 400;
}

/* ===== 主内容区 ===== */
.main-scroll {
  flex: 1;
  height: 0;
  margin-top: -32rpx;
}

.main-body {
  background: var(--bg-page);
  border-radius: 36rpx 36rpx 0 0;
  padding: 8rpx 24rpx 0;
  min-height: 100%;
}

/* 功能导航 */
.nav-grid {
  display: flex;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 12rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
}

.nav-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 38rpx;
  line-height: 1;
}

.nav-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-regular);
  text-align: center;
  line-height: 1.3;
}

/* 横幅 */
.banner {
  position: relative;
  height: 240rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  background: linear-gradient(120deg, #6b96ff 0%, var(--primary) 45%, #2348c8 100%);
  box-shadow: 0 14rpx 40rpx rgba(59, 102, 245, 0.32), 0 4rpx 12rpx rgba(15, 35, 95, 0.1);
}

.banner-content {
  position: relative;
  z-index: 3;
  padding: 40rpx 36rpx;
  max-width: 68%;
}

.banner-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.banner-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.5;
}

.banner-btn {
  display: inline-block;
  margin-top: 22rpx;
  padding: 12rpx 32rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: #fff;
  border-radius: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.banner-deco {
  position: absolute;
  right: 0;
  bottom: 0;
  top: 0;
  width: 45%;
  z-index: 1;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
}

.banner-deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.banner-deco-circle--1 {
  width: 160rpx;
  height: 160rpx;
  right: 24rpx;
  top: 30rpx;
}

.banner-deco-circle--2 {
  width: 100rpx;
  height: 100rpx;
  right: 120rpx;
  bottom: 40rpx;
  background: rgba(255, 255, 255, 0.07);
}

.banner-deco-bar {
  position: absolute;
  right: 40rpx;
  bottom: 0;
  width: 180rpx;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.03) 100%);
  border-radius: 12rpx 12rpx 0 0;
  transform: skewX(-8deg);
}

/* 公告栏 */
.notice-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft);
}

.notice-tag {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  border-radius: 10rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
  margin-left: 16rpx;
}

.notice-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-empty {
  flex: 1;
  margin-left: 16rpx;
  color: #bbb;
}

.notice-arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #c8ccd3;
  line-height: 1;
}

/* 2x2 服务卡片 */
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.service-card {
  position: relative;
  height: 176rpx;
  border-radius: var(--radius-md);
  padding: 28rpx 22rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
}

.service-card-text {
  position: relative;
  z-index: 2;
}

.service-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}

.service-card-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-placeholder);
  line-height: 1.4;
}

.service-card-icon-wrap {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.55;
}

.service-card-icon {
  font-size: 64rpx;
  line-height: 1;
}

/* 区块通用 */
.section {
  margin-bottom: 28rpx;
}

.section-last {
  margin-bottom: 0;
}

.section-header {
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-icon-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-icon-text {
  font-size: 20rpx;
  line-height: 1;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-divider {
  margin: 0 14rpx;
  font-size: 22rpx;
  color: #e0e0e0;
  font-weight: 300;
}

.section-sub {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.section-title-alone {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 便民服务列表 */
.service-list-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 4rpx 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 24rpx;
  box-shadow: var(--shadow-soft);
}

.service-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}

.service-list-item:nth-child(-n+4) {
  border-bottom: 1rpx solid #f2f3f5;
}

.service-list-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.service-list-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.service-list-label {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-list-arrow {
  font-size: 30rpx;
  color: #d9d9d9;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 8rpx;
  font-weight: 300;
}

/* 活动卡片样式（园区动态） */
.activity-card {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.activity-card:last-child {
  margin-bottom: 0;
}

.activity-cover {
  width: 196rpx;
  height: 196rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: linear-gradient(135deg, #e8edf5, #dce4ef);
}

.activity-body {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 196rpx;
  padding: 4rpx 0;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.activity-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
  line-height: 1.4;
}

.activity-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}

.activity-tag {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: #f2f3f5;
  border-radius: var(--radius-sm);
}

.activity-meta {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.empty-news {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 72rpx 0;
  text-align: center;
  box-shadow: var(--shadow-soft);
}

.empty-news-text {
  font-size: 26rpx;
  color: var(--text-placeholder);
}

.safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* 点击反馈 */
.press-scale {
  opacity: 0.82;
  transform: scale(0.98);
  transition: all 0.15s ease;
}
