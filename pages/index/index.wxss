page {
  --primary: #0047b3;
  --primary-light: #3d6fd4;
  --primary-dark: #003791;
  --bg-page: #f2f5fa;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --radius-lg: 24rpx;
  --space: 28rpx;
  --shadow-card: 0 10rpx 32rpx rgba(15, 40, 100, 0.1);
  --shadow-soft: 0 8rpx 24rpx rgba(15, 40, 100, 0.08);
  background: var(--bg-page);
}

.home-page {
  min-height: 100vh;
  height: 100vh;
  background: var(--primary-dark);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 蓝色主题头图 ===== */
.home-hero {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 32rpx 48rpx;
  background: linear-gradient(165deg, #003791 0%, #0047b3 48%, #3d6fd4 100%);
  overflow: hidden;
}

.home-hero-decor {
  position: absolute;
  right: -80rpx;
  top: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.home-hero-decor::after {
  content: '';
  position: absolute;
  left: -120rpx;
  bottom: -160rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

/* 日期：页面左上角顶部 */
.home-date-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 4rpx;
}

.home-date {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
}

.home-greeting {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* Logo：缩小居中 */
.home-logo-slot {
  position: relative;
  z-index: 1;
  margin: 12rpx auto 0;
  width: 220rpx;
  max-width: 42%;
  padding: 8rpx 14rpx 6rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #ffffff 0%, #eef3fb 100%);
  box-shadow: 0 6rpx 16rpx rgba(0, 20, 80, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-logo {
  width: 100%;
  display: block;
}

.home-hero-actions {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.hero-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-action-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0, 20, 80, 0.2);
}

.hero-action-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ffffff;
  text-align: center;
  line-height: 1.2;
}

/* 滚动区透明，让内容层圆角透出蓝头图；内容层铺满避免下半部露蓝 */
.home-scroll {
  flex: 1;
  height: 0;
  margin-top: -32rpx;
  position: relative;
  z-index: 2;
  background: transparent;
}

.home-sheet {
  min-height: 100%;
  box-sizing: border-box;
  padding: 36rpx 28rpx 0;
  background: var(--bg-page);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -8rpx 28rpx rgba(0, 30, 90, 0.12);
  overflow: hidden;
}

.secondary-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: var(--space);
  padding: 8rpx 4rpx 4rpx;
}

.secondary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.secondary-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.secondary-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #334155;
  text-align: center;
}

.parking-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--space);
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #003791 0%, #3d6fd4 100%);
  box-shadow: 0 12rpx 36rpx rgba(0, 55, 145, 0.28);
}

.parking-banner-main {
  flex: 1;
  min-width: 0;
}

.parking-banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.parking-banner-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.parking-banner-nums {
  text-align: right;
}

.parking-banner-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.parking-banner-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}

.parking-banner-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  padding-left: 8rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: var(--space);
  padding: 22rpx 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
}

.notice-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #003791;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 40rpx;
}

.pending-strip {
  margin-bottom: var(--space);
  padding: 24rpx 28rpx;
  background: #fff7ed;
  border-radius: 20rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid #fed7aa;
}

.pending-strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.pending-strip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #9a3412;
}

.pending-strip-badge {
  min-width: 36rpx;
  padding: 0 10rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ea580c;
  color: #fff;
  font-size: 22rpx;
}

.pending-strip-item {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(234, 88, 12, 0.15);
}

.pending-strip-plate {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #9a3412;
}

.pending-strip-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.service-card {
  position: relative;
  min-height: 180rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.service-card--blue {
  background: linear-gradient(145deg, #eef3fb 0%, #d6e4ff 100%);
}

.service-card--sky {
  background: linear-gradient(145deg, #e0f2fe 0%, #bae6fd 100%);
}

.service-card--teal {
  background: linear-gradient(145deg, #ccfbf1 0%, #99f6e4 100%);
}

.service-card--indigo {
  background: linear-gradient(145deg, #eef2ff 0%, #c7d2fe 100%);
}

.service-card-copy {
  position: relative;
  z-index: 1;
  max-width: 70%;
}

.service-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.service-card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.service-card-icon {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  opacity: 0.55;
}

.section-block {
  margin-bottom: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.news-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.news-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.news-row:last-child {
  border-bottom: none;
}

.news-row-main {
  flex: 1;
  min-width: 0;
}

.news-row-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.news-row-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.news-row-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #003791;
  background: #eef3fb;
}

.news-empty {
  padding: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: var(--shadow-soft);
}

.news-footer {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.safe-bottom {
  height: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

.press-scale {
  opacity: 0.88;
  transform: scale(0.98);
}
