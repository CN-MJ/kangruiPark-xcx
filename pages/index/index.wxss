page {
  --primary: #0047b3;
  --primary-light: #3d6fd4;
  --primary-dark: #003791;
  --bg-page: #f2f5fa;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --radius-lg: 24rpx;
  --space: 28rpx;
  --shadow-card: 0 10rpx 32rpx rgba(15, 40, 100, 0.1);
  --shadow-soft: 0 8rpx 24rpx rgba(15, 40, 100, 0.08);
  background: var(--bg-page);
}

.home-page {
  min-height: 100vh;
  height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.home-scroll {
  flex: 1;
  height: 0;
  background: var(--bg-page);
}

/* ===== 蓝色主题头图（随页滚动） ===== */
.home-hero {
  position: relative;
  padding: 8rpx 32rpx 40rpx;
  background: linear-gradient(165deg, #003791 0%, #0047b3 45%, #3d6fd4 100%);
  overflow: hidden;
}

.home-hero-decor {
  position: absolute;
  right: -80rpx;
  top: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.home-hero-decor::after {
  content: '';
  position: absolute;
  left: -120rpx;
  bottom: -160rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.home-date-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 4rpx;
}

.home-date {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
}

.home-greeting {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.home-logo-slot {
  position: relative;
  z-index: 1;
  margin: 20rpx auto 0;
  width: 360rpx;
  max-width: 72%;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-logo {
  width: 100%;
  display: block;
}

.home-hero-actions {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.hero-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-action-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0, 20, 80, 0.2);
}

.hero-action-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ffffff;
  text-align: center;
  line-height: 1.2;
}

.home-sheet {
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
  min-height: 60vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx 0;
  background: var(--bg-page);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -8rpx 28rpx rgba(0, 30, 90, 0.12);
}

.secondary-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: var(--space);
  padding: 8rpx 4rpx 4rpx;
}

.secondary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.secondary-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.secondary-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #334155;
  text-align: center;
}

.parking-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--space);
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #003791 0%, #3d6fd4 100%);
  box-shadow: 0 12rpx 36rpx rgba(0, 55, 145, 0.28);
}

.parking-banner-main {
  flex: 1;
  min-width: 0;
}

.parking-banner-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.parking-banner-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.parking-banner-nums {
  text-align: right;
}

.parking-banner-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.parking-banner-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}

.parking-banner-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  padding-left: 8rpx;
}

/* 健康企业汇首页内容卡 */
.ent-home-card {
  margin-bottom: var(--space);
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.ent-home-hero {
  position: relative;
  padding: 28rpx 28rpx 22rpx;
  background:
    linear-gradient(145deg, rgba(0, 55, 145, 0.08) 0%, rgba(61, 111, 212, 0.04) 42%, rgba(255, 255, 255, 0) 75%),
    #ffffff;
}

.ent-home-hero-glow {
  position: absolute;
  right: -40rpx;
  top: -50rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 71, 179, 0.14) 0%, transparent 70%);
  pointer-events: none;
}

.ent-home-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ent-home-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #003791;
  opacity: 0.85;
}

.ent-home-title {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 1rpx;
}

.ent-home-stats {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.ent-home-more-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #003791;
}

.ent-home-more {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.ent-home-audience {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.ent-home-aud {
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(0, 55, 145, 0.08);
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(15, 40, 100, 0.04);
}

.ent-home-aud-num {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #003791;
  line-height: 1;
}

.ent-home-aud-label {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #64748b;
}

.ent-home-district {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
}

.ent-home-district-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.ent-home-district-scroll {
  width: 100%;
  white-space: nowrap;
}

.ent-home-district-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.ent-home-district-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #475569;
  font-size: 22rpx;
  border: 1rpx solid rgba(0, 55, 145, 0.1);
}

.ent-home-district-chip.active {
  background: #003791;
  color: #fff;
  font-weight: 600;
  border-color: #003791;
}

.ent-home-section {
  padding: 8rpx 28rpx 8rpx;
}

.ent-home-section--list {
  padding-bottom: 28rpx;
}

.ent-home-section-head {
  margin-bottom: 16rpx;
}

.ent-home-section-head--row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding-right: 0;
}

.ent-home-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.ent-home-section-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.ent-home-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #003791;
  padding-bottom: 2rpx;
}

.ent-home-major-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.ent-home-major-tile {
  position: relative;
  padding: 20rpx 18rpx 18rpx;
  border-radius: 20rpx;
  overflow: hidden;
  min-height: 168rpx;
}

.ent-home-major-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.ent-home-major-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ent-home-major-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #64748b;
  line-height: 1.35;
}

.ent-home-major-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #94a3b8;
}

.ent-home-major-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 12rpx;
}

.ent-home-major-tag {
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 16rpx;
  color: #475569;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ent-home-list {
  white-space: nowrap;
  margin: 0 -28rpx;
}

.ent-home-list-row {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 28rpx;
}

.ent-home-item {
  width: 460rpx;
  display: inline-flex;
  flex-direction: column;
  background: #f8fafc;
  border-radius: 22rpx;
  overflow: hidden;
  vertical-align: top;
  border: 1rpx solid #eef2f7;
}

.ent-home-cover-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
  background: #e2e8f0;
}

.ent-home-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.ent-home-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(15, 23, 42, 0.55) 100%);
}

.ent-home-cover-cat {
  position: absolute;
  left: 16rpx;
  bottom: 14rpx;
  max-width: 60%;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #003791;
  font-size: 18rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ent-home-cover-settle {
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(16, 185, 129, 0.92);
  color: #fff;
  font-size: 18rpx;
}

.ent-home-item-body {
  padding: 18rpx 18rpx 20rpx;
  white-space: normal;
}

.ent-home-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ent-home-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.ent-home-chip {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.4;
}

.ent-home-chip.tone-aud {
  color: #0f766e;
  background: #ccfbf1;
}

.ent-home-chip.tone-cat {
  color: #1d4ed8;
  background: #dbeafe;
}

.ent-home-chip.tone-src {
  color: #9a3412;
  background: #ffedd5;
}

.ent-home-intro {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ent-home-empty {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  background: #f8fafc;
  border-radius: 16rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: var(--space);
  padding: 22rpx 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
}

.notice-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #003791;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 40rpx;
}

.pending-strip {
  margin-bottom: var(--space);
  padding: 24rpx 28rpx;
  background: #fff7ed;
  border-radius: 20rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid #fed7aa;
}

.pending-strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.pending-strip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #9a3412;
}

.pending-strip-badge {
  min-width: 36rpx;
  padding: 0 10rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ea580c;
  color: #fff;
  font-size: 22rpx;
}

.pending-strip-item {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(234, 88, 12, 0.15);
}

.pending-strip-plate {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #9a3412;
}

.pending-strip-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.service-card {
  position: relative;
  min-height: 180rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.service-card--blue {
  background: linear-gradient(145deg, #eef3fb 0%, #d6e4ff 100%);
}

.service-card--sky {
  background: linear-gradient(145deg, #e0f2fe 0%, #bae6fd 100%);
}

.service-card--teal {
  background: linear-gradient(145deg, #ccfbf1 0%, #99f6e4 100%);
}

.service-card--indigo {
  background: linear-gradient(145deg, #eef2ff 0%, #c7d2fe 100%);
}

.service-card-copy {
  position: relative;
  z-index: 1;
  max-width: 70%;
}

.service-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.service-card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.service-card-icon {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  opacity: 0.55;
}

.section-block {
  margin-bottom: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.news-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.news-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.news-row:last-child {
  border-bottom: none;
}

.news-row-main {
  flex: 1;
  min-width: 0;
}

.news-row-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.news-row-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.news-row-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #003791;
  background: #eef3fb;
}

.news-empty {
  padding: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: var(--shadow-soft);
}

.news-footer {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.safe-bottom {
  height: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

.press-scale {
  opacity: 0.88;
  transform: scale(0.98);
}
