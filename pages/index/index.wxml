<view class="home-page">
  <!-- 蓝色主题头图 -->
  <view class="home-hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-hero-decor"></view>

    <view class="home-date-bar">
      <text class="home-date">{{dateText}}</text>
      <text class="home-greeting">{{greeting}}</text>
    </view>

    <view class="home-logo-slot">
      <image class="home-logo" src="/images/home_top_logo.png" mode="widthFix" />
    </view>

    <view class="home-hero-actions">
      <view
        class="hero-action"
        wx:for="{{heroActions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onHeroTap"
        hover-class="press-scale"
      >
        <view class="hero-action-btn" style="background: {{item.bg}};">
          <kr-icon name="{{item.icon}}" size="44" color="{{item.iconColor}}" />
        </view>
        <text class="hero-action-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    class="home-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    lower-threshold="120"
    bindscrolltolower="onScrollToLower"
  >
    <view class="home-sheet">
      <!-- 次级入口 -->
      <view class="secondary-row">
        <view
          class="secondary-item"
          wx:for="{{secondaryEntries}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSecondaryTap"
          hover-class="press-scale"
        >
          <view class="secondary-icon">
            <kr-icon name="{{item.icon}}" size="40" color="{{item.iconColor}}" />
          </view>
          <text class="secondary-label">{{item.label}}</text>
        </view>
      </view>

      <!-- 停车余位横条 -->
      <view class="parking-banner" wx:if="{{parkingStats}}" bindtap="onParkingTap" hover-class="press-scale">
        <view class="parking-banner-main">
          <text class="parking-banner-title">停车余位</text>
          <text class="parking-banner-status">{{parkingStats.statusText}}</text>
        </view>
        <view class="parking-banner-nums">
          <text class="parking-banner-num">{{parkingStats.remaining_spots}}</text>
          <text class="parking-banner-unit">剩余 / {{parkingStats.total_spots}}</text>
        </view>
        <text class="parking-banner-link" wx:if="{{pendingCount > 0}}">待确认 {{pendingCount}}</text>
        <text class="parking-banner-link" wx:else>去办理 ›</text>
      </view>

      <!-- 公告 -->
      <view class="notice-bar" wx:if="{{notices.length > 0}}">
        <text class="notice-tag">公告</text>
        <swiper class="notice-swiper" vertical autoplay circular interval="4000">
          <swiper-item wx:for="{{notices}}" wx:key="id" data-id="{{item.id}}" bindtap="onNoticeTap">
            <text class="notice-text">{{item.title}}</text>
          </swiper-item>
        </swiper>
      </view>

      <!-- 待确认 -->
      <view class="pending-strip" wx:if="{{pendingCount > 0}}">
        <view class="pending-strip-head">
          <text class="pending-strip-title">摄像头待确认</text>
          <text class="pending-strip-badge">{{pendingCount}}</text>
        </view>
        <view
          class="pending-strip-item"
          wx:for="{{pendingEvents}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-direction="{{item.direction}}"
          bindtap="onPendingTap"
          hover-class="press-scale"
        >
          <text class="pending-strip-plate">{{item.plate_number}}</text>
          <text class="pending-strip-meta">{{item.direction_text}} · {{item.timeText}}</text>
        </view>
      </view>

      <!-- 服务卡片 2x2 -->
      <view class="service-grid">
        <view
          class="service-card service-card--{{item.tone}}"
          wx:for="{{serviceCards}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onServiceTap"
          hover-class="press-scale"
        >
          <view class="service-card-copy">
            <text class="service-card-title">{{item.title}}</text>
            <text class="service-card-desc">{{item.desc}}</text>
          </view>
          <view class="service-card-icon">
            <kr-icon name="{{item.icon}}" size="56" color="{{item.iconColor}}" />
          </view>
        </view>
      </view>

      <!-- 园区动态：直接展示，滑到底加载更多 -->
      <view class="section-block">
        <view class="section-head">
          <text class="section-title">园区动态</text>
        </view>
        <view class="news-list" wx:if="{{newsList.length > 0}}">
          <view
            class="news-row"
            wx:for="{{newsList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onNewsTap"
            hover-class="press-scale"
          >
            <view class="news-row-main">
              <text class="news-row-title">{{item.title}}</text>
              <text class="news-row-time">{{item.timeText}}</text>
            </view>
            <text class="news-row-tag" wx:if="{{item.isTop}}">置顶</text>
          </view>
        </view>
        <view class="news-empty" wx:elif="{{!newsLoading}}">暂无动态</view>
        <view class="news-footer" wx:if="{{newsList.length > 0}}">
          <text wx:if="{{newsLoadingMore}}">加载中...</text>
          <text wx:elif="{{!newsHasMore}}">没有更多了</text>
        </view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <tab-bar active="index" />
</view>
