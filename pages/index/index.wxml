<view class="page">
  <!-- 顶部蓝色区域 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-top" style="height: {{navBarHeight}}px;">
      <image class="header-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="header-location" bindtap="onLocationTap">
        <view class="location-row">
          <text class="location-name">{{parkName}}</text>
          <text class="location-arrow">▾</text>
        </view>
        <text class="location-sub">{{dateText}}  {{weatherText}}</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-actions">
      <view
        class="quick-item"
        wx:for="{{quickActions}}"
        wx:key="id"
        data-action="{{item.id}}"
        bindtap="onQuickAction"
        hover-class="press-scale"
        hover-stay-time="100"
      >
        <view class="quick-icon-wrap" style="background: {{item.bg}};">
          <text class="quick-icon">{{item.icon}}</text>
        </view>
        <text class="quick-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 主内容滚动区 -->
  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="main-body">
      <!-- 功能导航 -->
      <view class="nav-grid">
        <view
          class="nav-item"
          wx:for="{{navItems}}"
          wx:key="id"
          data-action="{{item.id}}"
          bindtap="onNavTap"
          hover-class="press-scale"
          hover-stay-time="100"
        >
          <view class="nav-icon-wrap" style="background: {{item.bg}};">
            <text class="nav-icon">{{item.icon}}</text>
          </view>
          <text class="nav-label">{{item.label}}</text>
        </view>
      </view>

      <!-- 横幅 -->
      <view class="banner" bindtap="onBannerTap" hover-class="press-scale" hover-stay-time="100">
        <view class="banner-content">
          <text class="banner-title">{{banner.title}}</text>
          <text class="banner-sub">{{banner.subtitle}}</text>
          <view class="banner-btn">{{banner.btnText}}</view>
        </view>
        <view class="banner-deco">
          <view class="banner-deco-circle banner-deco-circle--1"></view>
          <view class="banner-deco-circle banner-deco-circle--2"></view>
          <view class="banner-deco-bar"></view>
        </view>
      </view>

      <!-- 公告栏 -->
      <view class="notice-bar" hover-class="press-scale" hover-stay-time="100">
        <view class="notice-tag">公告</view>
        <swiper class="notice-swiper" vertical autoplay circular interval="4000" duration="500" wx:if="{{notices.length > 0}}">
          <swiper-item wx:for="{{notices}}" wx:key="id" data-id="{{item.id}}" bindtap="onNoticeItemTap">
            <text class="notice-text">{{item.text}}</text>
          </swiper-item>
        </swiper>
        <text class="notice-text notice-empty" wx:else>暂无公告</text>
        <text class="notice-arrow" bindtap="onNoticeTap">›</text>
      </view>

      <!-- 公告下方：物业服务 / 停车服务 / 场馆预定 / 企业增值 -->
      <view class="service-grid">
        <view
          class="service-card"
          wx:for="{{serviceCards}}"
          wx:key="id"
          style="background: {{item.bg}};"
          data-action="{{item.id}}"
          bindtap="onServiceCardTap"
          hover-class="press-scale"
          hover-stay-time="100"
        >
          <view class="service-card-text">
            <text class="service-card-title">{{item.title}}</text>
            <text class="service-card-sub">{{item.subtitle}}</text>
          </view>
          <view class="service-card-icon-wrap">
            <text class="service-card-icon">{{item.icon}}</text>
          </view>
        </view>
      </view>

      <!-- 便民服务 -->
      <view class="section">
        <view class="section-header">
          <view class="section-title-wrap">
            <view class="section-icon-badge">
              <text class="section-icon-text">👍</text>
            </view>
            <text class="section-title">{{serviceSection.title}}</text>
            <text class="section-divider">|</text>
            <text class="section-sub">{{serviceSection.subtitle}}</text>
          </view>
        </view>
        <view class="service-list-card">
          <view
            class="service-list-item"
            wx:for="{{serviceList}}"
            wx:key="id"
            data-action="{{item.id}}"
            bindtap="onServiceListTap"
            hover-class="press-scale"
            hover-stay-time="100"
          >
            <view class="service-list-left">
              <view class="service-list-icon" style="background: {{item.bg}};">{{item.icon}}</view>
              <text class="service-list-label">{{item.label}}</text>
            </view>
            <text class="service-list-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 园区动态（活动卡片样式，内容为园区自有数据） -->
      <view class="section section-last">
        <view class="section-header section-header-row">
          <text class="section-title-alone">{{newsSection.title}}</text>
          <text class="section-more" bindtap="onNewsMore">更多</text>
        </view>

        <view wx:if="{{newsList.length > 0}}">
          <view
            class="activity-card"
            wx:for="{{newsList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onNewsTap"
            hover-class="press-scale"
            hover-stay-time="100"
          >
            <image
              class="activity-cover"
              src="{{item.cover_image || defaultCover}}"
              mode="aspectFill"
            />
            <view class="activity-body">
              <text class="activity-title">{{item.title}}</text>
              <text class="activity-time">{{item.timeText}}</text>
              <view class="activity-footer">
                <view class="activity-tag">{{item.tag}}</view>
                <text class="activity-meta">{{item.meta}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-news" wx:else>
          <text class="empty-news-text">暂无园区动态，敬请期待</text>
        </view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <tab-bar active="index" />
</view>
