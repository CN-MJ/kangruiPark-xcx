<view class="home-page">
  <view class="home-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-header-inner">
      <view class="home-brand">
        <text class="home-greeting">{{greeting}}</text>
        <text class="home-title">{{parkName}}</text>
        <text class="home-date">{{dateText}}</text>
      </view>
      <view class="home-badge">智慧园区</view>
    </view>
  </view>

  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="home-body">
      <!-- 三大核心功能 -->
      <view class="core-grid">
        <view
          class="core-card core-card--{{item.tone}}"
          wx:for="{{coreServices}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCoreTap"
          hover-class="press-scale"
        >
          <view class="core-icon">
            <kr-icon name="{{item.icon}}" size="44" color="{{item.iconColor}}" />
          </view>
          <text class="core-title">{{item.title}}</text>
          <text class="core-desc">{{item.desc}}</text>
        </view>
      </view>

      <!-- 停车余位 -->
      <view class="parking-panel" wx:if="{{parkingStats}}" bindtap="onParkingTap" hover-class="press-scale">
        <view class="parking-panel-head">
          <view>
            <text class="parking-panel-title">停车余位</text>
            <text class="parking-panel-status">{{parkingStats.statusText}}</text>
          </view>
          <view class="parking-panel-right">
            <text class="pending-dot" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
            <text class="parking-panel-link">去办理 ›</text>
          </view>
        </view>
        <view class="parking-panel-stats">
          <view class="parking-stat">
            <text class="parking-stat-num">{{parkingStats.remaining_spots}}</text>
            <text class="parking-stat-label">剩余</text>
          </view>
          <view class="parking-stat">
            <text class="parking-stat-num muted">{{parkingStats.occupied_count}}</text>
            <text class="parking-stat-label">已占</text>
          </view>
          <view class="parking-stat">
            <text class="parking-stat-num muted">{{parkingStats.total_spots}}</text>
            <text class="parking-stat-label">总数</text>
          </view>
        </view>
        <view class="parking-progress">
          <view class="parking-progress-bar" style="width: {{parkingStats.percent}}%;"></view>
        </view>
      </view>

      <view class="pending-strip" wx:if="{{pendingCount > 0}}">
        <view class="pending-strip-head">
          <text class="pending-strip-title">摄像头待确认</text>
          <text class="pending-strip-badge">{{pendingCount}}</text>
        </view>
        <view
          class="pending-strip-item"
          wx:for="{{pendingEvents}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-direction="{{item.direction}}"
          bindtap="onPendingTap"
          hover-class="press-scale"
        >
          <text class="pending-strip-plate">{{item.plate_number}}</text>
          <text class="pending-strip-meta">{{item.direction_text}} · {{item.timeText}}</text>
        </view>
      </view>

      <!-- 公告 -->
      <view class="notice-panel" wx:if="{{notices.length > 0}}">
        <text class="notice-panel-tag">公告</text>
        <swiper class="notice-panel-swiper" vertical autoplay circular interval="4000">
          <swiper-item wx:for="{{notices}}" wx:key="id" data-id="{{item.id}}" bindtap="onNoticeTap">
            <text class="notice-panel-text">{{item.title}}</text>
          </swiper-item>
        </swiper>
      </view>

      <!-- 快捷入口 -->
      <view class="section-block">
        <view class="section-head">
          <text class="section-title">常用服务</text>
        </view>
        <scroll-view class="quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="quick-row">
            <view
              class="quick-chip"
              wx:for="{{quickEntries}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="onQuickTap"
              hover-class="press-scale"
            >
              <view class="quick-chip-icon">
                <kr-icon name="{{item.icon}}" size="40" color="#0f766e" />
              </view>
              <text class="quick-chip-label">{{item.label}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 园区动态 -->
      <view class="section-block section-block--last">
        <view class="section-head">
          <text class="section-title">园区动态</text>
          <text class="section-more" bindtap="onNewsMore">更多</text>
        </view>
        <view class="news-list" wx:if="{{newsList.length > 0}}">
          <view
            class="news-row"
            wx:for="{{newsList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onNewsTap"
            hover-class="press-scale"
          >
            <view class="news-row-main">
              <text class="news-row-title">{{item.title}}</text>
              <text class="news-row-time">{{item.timeText}}</text>
            </view>
            <text class="news-row-tag" wx:if="{{item.isTop}}">置顶</text>
          </view>
        </view>
        <view class="news-empty" wx:else>暂无动态</view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <tab-bar active="index" />
</view>
