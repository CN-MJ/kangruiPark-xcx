<view class="page-wrap checkin-page">
  <view class="card checkin-card">
    <text class="checkin-icon">📍</text>
    <text class="checkin-title">入住签到</text>
    <text class="checkin-sub">签到后身份将从访客升级为商户</text>

    <view class="form-item">
      <text class="form-label">姓名</text>
      <view class="form-field">
        <input class="form-input" placeholder="请输入姓名" placeholder-class="form-placeholder" value="{{userName}}" bindinput="onNameInput" />
      </view>
    </view>
    <view class="form-item" wx:if="{{userPhone}}">
      <text class="form-label">手机号</text>
      <view class="form-field readonly-field">
        <text class="readonly-phone">{{userPhone}}</text>
      </view>
    </view>

    <view class="action-btn action-btn-primary {{submitting ? 'is-loading' : ''}}" bindtap="onCheckin">
      <view wx:if="{{submitting}}" class="action-btn-spinner"></view>
      <text class="action-btn-text">确认签到</text>
    </view>
  </view>
</view>
