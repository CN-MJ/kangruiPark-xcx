.checkin-page {
  padding-top: 40rpx;
}

.checkin-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.checkin-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.checkin-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.checkin-sub {
  display: block;
  margin: 16rpx 0 32rpx;
  font-size: 26rpx;
  color: #999;
}

.status-box {
  margin: 0 0 32rpx;
  padding: 24rpx;
  text-align: left;
  background: #f3f6fc;
  border-radius: 12rpx;
  border: 1rpx solid #a8c0ef;
}

.status-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0047b3;
  margin-bottom: 8rpx;
}

.status-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.checkin-card .form-item {
  text-align: left;
}

.readonly-field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
}

.readonly-phone {
  font-size: 30rpx;
  color: #334155;
}
