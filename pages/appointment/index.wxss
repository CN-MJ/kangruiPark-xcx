.appointment-hub .hub-hero {
  background: linear-gradient(135deg, #115e59, #0f766e);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.hub-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.hub-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.hub-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 118, 110, 0.06);
  border-left: 6rpx solid #0f766e;
}

.hub-item--green { border-left-color: #16a34a; }
.hub-item--amber { border-left-color: #d97706; }
.hub-item--gray { border-left-color: #64748b; }

.hub-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hub-item-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.hub-item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2b2a;
}

.hub-item-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.hub-item-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
  margin-left: 12rpx;
}

.press-scale {
  opacity: 0.88;
}
