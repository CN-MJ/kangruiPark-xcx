<view class="page-wrap">
  <view class="form-tip" wx:if="{{appointmentType === 'service'}}">预约企业服务，提交后等待企业确认；可在「预约查询」查看进度</view>
  <view class="form-tip" wx:elif="{{appointmentType === 'visitor'}}">提交后需拜访企业确认，您可在「预约查询」查看进度</view>
  <view class="form-tip" wx:elif="{{appointmentType === 'venue'}}">请选择场馆与时间，提交后等待园区确认</view>
  <view class="card">
    <view class="form-item" wx:if="{{appointmentType === 'service'}}">
      <text class="form-label">预约服务</text>
      <view class="form-picker">{{serviceName || '未选择服务'}}</view>
    </view>
    <view class="form-item" wx:if="{{appointmentType === 'service' && enterpriseName}}">
      <text class="form-label">所属企业</text>
      <view class="form-picker">{{enterpriseName}}</view>
    </view>

    <view class="form-item">
      <text class="form-label">姓名</text>
      <view class="form-field">
        <input
          class="form-input"
          placeholder="请输入姓名"
          placeholder-class="form-placeholder"
          value="{{userName}}"
          bindinput="onNameInput"
        />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="form-field">
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="form-placeholder"
          value="{{userPhone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="form-item" wx:if="{{appointmentType === 'visitor'}}">
      <text class="form-label">拜访公司</text>
      <picker
        wx:if="{{merchantNames.length}}"
        mode="selector"
        range="{{merchantNames}}"
        value="{{merchantIndex}}"
        bindchange="onMerchantChange"
      >
        <view class="form-picker">{{merchantNames[merchantIndex]}}</view>
      </picker>
      <view class="form-picker placeholder" wx:elif="{{merchantsLoading}}">加载中...</view>
      <view class="form-picker placeholder" wx:else>暂无可选公司</view>
    </view>

    <view class="form-item" wx:if="{{appointmentType !== 'visitor' && appointmentType !== 'service'}}">
      <text class="form-label">预约项目</text>
      <picker mode="selector" range="{{resources}}" value="{{resourceIndex}}" bindchange="onResourceChange">
        <view class="form-picker">{{resources[resourceIndex]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">预约日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="form-picker {{date ? '' : 'placeholder'}}">{{date || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">预约时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="form-picker">{{time}}</view>
      </picker>
    </view>
    <view class="action-btn action-btn-primary {{submitting ? 'is-loading' : ''}}" bindtap="onSubmit">
      <view wx:if="{{submitting}}" class="action-btn-spinner"></view>
      <text class="action-btn-text">提交预约</text>
    </view>
  </view>
</view>
