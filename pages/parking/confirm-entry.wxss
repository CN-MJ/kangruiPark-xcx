.confirm-page {
  min-height: 100vh;
  background: var(--bg-page);
}

.confirm-hero {
  margin: -24rpx -24rpx 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.confirm-hero.entry {
  background: linear-gradient(135deg, #115e59, #0f766e);
}

.confirm-hero-title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.confirm-hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.confirm-card {
  text-align: center;
}

.confirm-plate {
  font-size: 48rpx;
  font-weight: 700;
  color: #0f766e;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.confirm-meta-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
  font-size: 26rpx;
}

.confirm-meta-label {
  color: #64748b;
}

.confirm-meta-value {
  color: #1c2b2a;
}

.confirm-empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

.confirm-actions {
  margin-top: 32rpx;
}

.park-loading {
  text-align: center;
  padding: 60rpx;
  color: #94a3b8;
}
