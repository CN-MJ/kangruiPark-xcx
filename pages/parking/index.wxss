.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #3b66f5;
}

.stats-num.sub {
  font-size: 40rpx;
  color: #666;
}

.stats-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 95, 0.08);
}

.mode-tab.active {
  color: #fff;
  background: #3b66f5;
  font-weight: 500;
}

.action-btn-exit {
  margin-top: 32rpx;
  background: #52c41a;
}

.action-btn-exit.is-loading {
  opacity: 0.75;
}

.active-record {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f6ffed;
  border-radius: 12rpx;
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}

.active-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #52c41a;
  margin-bottom: 12rpx;
}

.active-meta {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.query-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3b66f5;
}
