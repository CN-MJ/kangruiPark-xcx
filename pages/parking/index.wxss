page {
  background: #f4f7f6;
}

.parking-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.parking-hero {
  background: linear-gradient(135deg, #115e59 0%, #0f766e 60%, #14b8a6 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.parking-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.parking-hero-title {
  font-size: 28rpx;
  opacity: 0.9;
}

.parking-hero-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.parking-hero-main {
  margin: 24rpx 0 20rpx;
}

.parking-hero-num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.parking-hero-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.parking-hero-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
}

.parking-hero-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
}

.parking-hero-meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.mode-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-switch-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 118, 110, 0.06);
  border: 2rpx solid transparent;
}

.mode-switch-item.active {
  border-color: #0f766e;
  background: #ecfdf5;
}

.mode-switch-item.active.exit {
  border-color: #16a34a;
  background: #f0fdf4;
}

.mode-switch-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.mode-switch-label {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}

.parking-form {
  margin-bottom: 20rpx;
}

.form-step-tip {
  display: block;
  margin: -8rpx 0 24rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.plate-field {
  background: #f8fafc;
}

.plate-input {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.active-record {
  margin: 20rpx 0;
  padding: 24rpx;
  background: #ecfdf5;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.15);
}

.active-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f766e;
  margin-bottom: 12rpx;
}

.active-meta {
  display: block;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

.action-btn-outline {
  margin-top: 24rpx;
  background: #fff;
  border: 2rpx solid #0f766e;
}

.action-btn-text.outline {
  color: #0f766e;
}

.action-btn-exit {
  margin-top: 16rpx;
  background: #16a34a;
}

.parking-tip {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 12rpx 0;
}

.pending-card {
  margin-bottom: 24rpx;
}

.pending-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pending-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #dc2626;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.pending-item-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-plate {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2b2a;
}

.pending-type {
  font-size: 22rpx;
  color: #0f766e;
  background: #ecfdf5;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.pending-type.exit {
  color: #16a34a;
  background: #f0fdf4;
}

.pending-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.press-scale {
  opacity: 0.88;
}
