<view class="parking-page">
  <view class="parking-hero" wx:if="{{stats}}">
    <view class="parking-hero-top">
      <text class="parking-hero-title">停车场余位</text>
      <text class="parking-hero-status">{{occupancyText}}</text>
    </view>
    <view class="parking-hero-main">
      <text class="parking-hero-num">{{stats.remaining_spots}}</text>
      <text class="parking-hero-unit">剩余车位</text>
    </view>
    <view class="parking-hero-bar">
      <view class="parking-hero-bar-fill" style="width: {{occupancyPercent}}%;"></view>
    </view>
    <view class="parking-hero-meta">
      <text>已占 {{stats.occupied_count}} / 共 {{stats.total_spots}}</text>
    </view>
  </view>

  <view class="card pending-card" wx:if="{{pendingCount > 0}}">
    <view class="pending-head">
      <text class="card-title">待确认事件</text>
      <text class="pending-badge">{{pendingCount}}</text>
    </view>
    <view
      class="pending-item"
      wx:for="{{pendingEvents}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-direction="{{item.direction}}"
      bindtap="onPendingTap"
      hover-class="press-scale"
    >
      <view class="pending-item-main">
        <text class="pending-plate">{{item.plate_number}}</text>
        <text class="pending-type {{item.direction === 2 ? 'exit' : ''}}">{{item.direction_text}}</text>
      </view>
      <text class="pending-time">{{item.timeText}}</text>
    </view>
  </view>

  <view class="mode-switch">
    <view class="mode-switch-item {{mode === 'entry' ? 'active' : ''}}" data-mode="entry" bindtap="onModeChange">
      <view class="mode-switch-icon">
        <kr-icon name="entry" size="40" color="{{mode === 'entry' ? '#0f766e' : '#64748b'}}" />
      </view>
      <text class="mode-switch-label">车辆入场</text>
    </view>
    <view class="mode-switch-item {{mode === 'exit' ? 'active exit' : ''}}" data-mode="exit" bindtap="onModeChange">
      <view class="mode-switch-icon">
        <kr-icon name="exit" size="40" color="{{mode === 'exit' ? '#16a34a' : '#64748b'}}" />
      </view>
      <text class="mode-switch-label">车辆出场</text>
    </view>
  </view>

  <view class="card parking-form">
    <view class="card-title">{{mode === 'entry' ? '入场登记' : '出场登记'}}</view>
    <text class="form-step-tip">{{mode === 'entry' ? '输入车牌号，系统将校验是否重复入场' : '输入车牌号并查询在场记录后确认出场'}}</text>

    <view class="form-item">
      <text class="form-label">车牌号</text>
      <view class="form-field plate-field">
        <input
          class="form-input plate-input"
          placeholder="如：粤B12345"
          placeholder-class="form-placeholder"
          value="{{plateNumber}}"
          bindinput="onPlateInput"
          bindconfirm="onQueryActive"
        />
      </view>
    </view>

    <view class="active-record" wx:if="{{mode === 'exit' && activeRecord}}">
      <view class="active-label">
        <kr-icon name="checkin" size="28" color="#16a34a" />
        <text>已找到在场记录</text>
      </view>
      <text class="active-meta">车牌：{{activeRecord.plate_number}}</text>
      <text class="active-meta">入场：{{activeRecord.entryText}}</text>
    </view>

    <view class="action-btn action-btn-primary {{loading ? 'is-loading' : ''}}" bindtap="onSubmit" wx:if="{{mode === 'entry'}}">
      <view wx:if="{{loading}}" class="action-btn-spinner"></view>
      <text class="action-btn-text">确认入场</text>
    </view>

    <block wx:if="{{mode === 'exit'}}">
      <view class="action-btn action-btn-outline" bindtap="onQueryActive">
        <text class="action-btn-text outline">查询在场记录</text>
      </view>
      <view class="action-btn action-btn-exit {{loading ? 'is-loading' : ''}}" bindtap="onSubmit">
        <view wx:if="{{loading}}" class="action-btn-spinner"></view>
        <text class="action-btn-text">确认出场</text>
      </view>
    </block>
  </view>

  <view class="parking-tip">{{mode === 'entry' ? '同一车牌在场期间不可重复入场' : '出场后车位将自动释放'}}</view>
</view>
