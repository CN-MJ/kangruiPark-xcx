.avatar-box {
  display: flex;
  align-items: center;
}

.avatar-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #eef2f6;
}

.avatar-tip {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #0047b3;
}

.avatar-limit {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.phone-readonly {
  font-size: 28rpx;
  line-height: 88rpx;
  color: #94a3b8;
}
