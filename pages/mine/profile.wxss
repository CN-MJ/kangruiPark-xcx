.avatar-box {
  display: flex;
  align-items: center;
}

.avatar-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #eef2f6;
}

.avatar-tip {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #0047b3;
}

.avatar-limit {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.phone-readonly {
  font-size: 28rpx;
  line-height: 88rpx;
  color: #94a3b8;
}

.identity-tip {
  display: block;
  margin: -4rpx 0 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.identity-row {
  display: flex;
  gap: 16rpx;
}

.identity-chip {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.identity-chip.is-on {
  background: #e8f1ff;
  color: #1f6feb;
  border-color: #1f6feb;
}

.form-picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.form-picker.placeholder {
  color: #94a3b8;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.apply-box {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #eff6ff;
}

.apply-box.rejected {
  background: #fef2f2;
}

.apply-status {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
  margin-bottom: 8rpx;
}

.apply-box.rejected .apply-status {
  color: #b91c1c;
}
