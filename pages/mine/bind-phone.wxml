<view class="page-wrap bind-phone-page">
  <view class="card">
    <view class="card-title">验证手机号</view>
    <text class="bind-tip">绑定后可用于车辆管理、停车确认等功能</text>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="form-field">
        <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <view class="form-field code-field">
          <input class="form-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
        </view>
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">姓名（选填）</text>
      <view class="form-field">
        <input class="form-input" placeholder="便于园区识别" value="{{name}}" bindinput="onNameInput" />
      </view>
    </view>

    <text class="dev-hint" wx:if="{{devHint}}">{{devHint}}</text>

    <view class="action-btn action-btn-primary {{submitting ? 'is-loading' : ''}}" bindtap="onSubmit">
      <text class="action-btn-text">确认绑定</text>
    </view>
  </view>
</view>
