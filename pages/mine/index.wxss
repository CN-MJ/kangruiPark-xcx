.mine-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #f4f7f6;
}

.mine-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #115e59 0%, #0f766e 55%, #14b8a6 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 118, 110, 0.22);
}

.mine-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.mine-info {
  margin-left: 24rpx;
}

.mine-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.mine-phone {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-tag {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #115e59;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.highlight-card {
  border: 1rpx solid rgba(15, 118, 110, 0.2);
  background: linear-gradient(135deg, #f0fdfa 0%, #ecfdf5 100%);
}

.park-card {
  border: 1rpx solid rgba(15, 118, 110, 0.15);
}

.park-title {
  color: #115e59;
  font-weight: 600;
}

.logout-title {
  color: #cf1322;
}

.version-wrap {
  margin-top: 48rpx;
  text-align: center;
  padding: 24rpx;
}

.version-text {
  font-size: 24rpx;
  color: #bbb;
}
