.mine-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
}

.mine-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #003791 0%, #0047b3 55%, #3d6fd4 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 55, 145, 0.22);
}

.mine-header--clickable:active {
  opacity: 0.92;
}

.mine-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.mine-info {
  margin-left: 24rpx;
}

.mine-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.mine-phone {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.mine-edit-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-tag {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #003791;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8rpx;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.highlight-card {
  border: 1rpx solid rgba(0, 55, 145, 0.2);
  background: linear-gradient(135deg, #f3f6fc 0%, #eef3fb 100%);
}

.park-card {
  border: 1rpx solid rgba(0, 55, 145, 0.15);
}

.park-title {
  color: #003791;
  font-weight: 600;
}

.logout-title {
  color: #cf1322;
}

.version-wrap {
  margin-top: 48rpx;
  text-align: center;
  padding: 24rpx;
}

.version-text {
  font-size: 24rpx;
  color: #bbb;
}
