.bind-tip {
  display: block;
  margin: -8rpx 0 24rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-field {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #eef3fb;
  color: #0047b3;
  font-size: 24rpx;
}

.code-btn.disabled {
  color: #94a3b8;
  background: #f1f5f9;
}

.dev-hint {
  display: block;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #d97706;
}
