<view class="pick-page">
  <view class="pick-sticky">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索企业名称 / 业务 / 地址"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>

    <view class="filter-bar">
      <view class="cat-trigger {{hasCategoryFilter || district ? 'active' : ''}}" bindtap="openCatPanel">
        <view class="cat-trigger-main">
          <text class="cat-trigger-label">筛选</text>
          <text class="cat-trigger-value">{{filterSummary}}</text>
        </view>
        <text class="cat-trigger-arrow">▼</text>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-chip {{settleOnly ? 'active' : ''}}" bindtap="onToggleSettle">仅入驻园区</view>
    </view>
  </view>

  <view
    class="ent-row {{selectedId === item.id ? 'is-on' : ''}}"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-name="{{item.name}}"
    bindtap="onSelect"
  >
    <view class="ent-main">
      <view class="ent-title-row">
        <text class="ent-title">{{item.name}}</text>
        <text class="ent-park" wx:if="{{item.settle_in_park}}">入驻</text>
      </view>
      <view class="ent-tags">
        <text class="ent-tag" wx:if="{{item.district}}">{{item.district}}</text>
        <text class="ent-tag" wx:if="{{item.categoryName}}">{{item.categoryName}}</text>
      </view>
      <text class="ent-intro" wx:if="{{item.intro}}">{{item.intro}}</text>
    </view>
    <text class="ent-pick">{{selectedId === item.id ? '已选' : '选择'}}</text>
  </view>

  <view class="empty-tip" wx:if="{{loading && !list.length}}">加载中...</view>
  <view class="empty-tip" wx:elif="{{!loading && !list.length}}">未找到企业，试试换个关键词</view>
  <view class="footer-tip" wx:if="{{list.length}}">
    <text wx:if="{{loadingMore}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>

  <view class="cat-mask" wx:if="{{catPanelOpen}}" catchtouchmove="preventMove" bindtap="closeCatPanel">
    <view class="cat-sheet" catchtap="preventMove">
      <view class="cat-sheet-head">
        <text class="cat-sheet-title">分类与区县</text>
        <view class="cat-sheet-actions">
          <text class="cat-sheet-reset" bindtap="onClearCategory">重置</text>
          <text class="cat-sheet-done" bindtap="closeCatPanel">完成</text>
        </view>
      </view>

      <view class="district-panel">
        <text class="district-panel-label">区县</text>
        <scroll-view class="district-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="district-row">
            <view class="district-chip {{district === '' ? 'active' : ''}}" data-name="" bindtap="onDistrict">全部</view>
            <view
              class="district-chip {{district === item ? 'active' : ''}}"
              wx:for="{{districtOptions}}"
              wx:key="*this"
              data-name="{{item}}"
              bindtap="onDistrict"
            >{{item}}</view>
          </view>
        </scroll-view>
      </view>

      <view class="cat-body">
        <scroll-view class="cat-left" scroll-y>
          <view
            class="cat-left-item {{panelMajorId === 0 ? 'active' : ''}}"
            data-id="0"
            bindtap="onPanelMajor"
          >全部分类</view>
          <view
            class="cat-left-item {{panelMajorId === item.id ? 'active' : ''}}"
            wx:for="{{panelMajors}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onPanelMajor"
          >{{item.shortName || item.name}}</view>
        </scroll-view>
        <scroll-view class="cat-right" scroll-y>
          <block wx:if="{{panelMajor}}">
            <view
              class="cat-right-item {{panelCategoryId === 0 ? 'active' : ''}}"
              bindtap="onPanelAllMinors"
            >全部小类</view>
            <view
              class="cat-right-item {{panelCategoryId === item.id ? 'active' : ''}}"
              wx:for="{{panelMinors}}"
              wx:key="id"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              bindtap="onPanelMinor"
            >{{item.name}}</view>
          </block>
          <view class="cat-right-empty" wx:else>请选择左侧大类</view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
