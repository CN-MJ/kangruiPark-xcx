.login-card {
  padding-bottom: 40rpx;
}

.login-tip {
  display: block;
  margin: -8rpx 0 36rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
}

.phone-login-btn {
  margin: 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: #003791;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  box-shadow: none;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn--press {
  opacity: 0.88;
}

.phone-login-btn.is-loading {
  opacity: 0.7;
}

.phone-login-btn[disabled] {
  opacity: 0.7;
}

.mock-box {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e2e8f0;
}

.mock-tip {
  display: block;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.mock-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mock-preset {
  width: calc(50% - 6rpx);
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.mock-preset.is-active {
  background: #e8f0ff;
  border-color: #93b4e8;
}

.mock-preset-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.mock-preset-phone {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.mock-hint-line {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.mock-input {
  height: 80rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #0f172a;
}

.mock-btn {
  height: 80rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mock-btn.is-loading {
  opacity: 0.7;
}

.mock-btn-text {
  font-size: 26rpx;
  color: #64748b;
}

.press-opacity {
  opacity: 0.72;
}
