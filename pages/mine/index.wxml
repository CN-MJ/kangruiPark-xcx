<view class="mine-page">
  <view class="mine-header mine-header--clickable" bindtap="onHeaderTap">
    <image class="mine-avatar" src="{{userAvatar || '/images/default-avatar.jpg'}}" mode="aspectFill" binderror="onAvatarError" />
    <view class="mine-info">
      <view class="name-row">
        <text class="mine-name">{{userName}}</text>
        <text class="role-tag">{{roleText}}</text>
      </view>
      <text class="mine-phone">{{headerPhoneText}}</text>
      <text class="mine-edit-hint" wx:if="{{hasUserAccount}}">点击编辑资料</text>
    </view>
  </view>

  <!-- 个人功能 -->
  <view class="card menu-card" bindtap="goOrders">
    <text class="menu-title">我的订单</text>
    <text class="menu-arrow">›</text>
  </view>

  <view class="card menu-card" bindtap="goVehicles">
    <view>
      <text class="menu-title">我的车辆</text>
      <text class="menu-desc">绑定车牌，接收摄像头识别提醒</text>
    </view>
    <text class="menu-arrow">›</text>
  </view>

  <view class="card menu-card" bindtap="goEnterprises">
    <view>
      <text class="menu-title">健康企业汇</text>
      <text class="menu-desc">浏览园区健康服务企业</text>
    </view>
    <text class="menu-arrow">›</text>
  </view>

  <view class="card menu-card" bindtap="goContact">
    <text class="menu-title">联系物业</text>
    <text class="menu-arrow">›</text>
  </view>

  <view class="card menu-card" wx:if="{{hasUserAccount && !isParkAccount}}" bindtap="onApplyStaff">
    <view>
      <text class="menu-title">申请成为工作人员</text>
      <text class="menu-desc">{{staffApplyDesc}}</text>
    </view>
    <text class="menu-arrow">›</text>
  </view>

  <!-- 园区工作台：仅园区人员账号（role=park）可见，进入后再用账号密码 -->
  <block wx:if="{{hasUserAccount && isParkAccount}}">
    <view class="card menu-card park-card" wx:if="{{!isParkStaff}}" bindtap="goParkLogin">
      <view>
        <text class="menu-title park-title">园区工作台</text>
        <text class="menu-desc">园区人员专用 · 账号密码登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="card menu-card park-card" wx:if="{{isParkStaff}}" bindtap="goParkHome">
      <view>
        <text class="menu-title park-title">进入园区工作台</text>
        <text class="menu-desc">已登录：{{parkStaffName}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="card menu-card" wx:if="{{isParkStaff}}" bindtap="onLogoutPark">
      <text class="menu-title logout-title">退出园区工作台</text>
      <text class="menu-arrow">›</text>
    </view>
  </block>

  <view class="card menu-card" wx:if="{{hasUserAccount}}" bindtap="onLogoutUser">
    <text class="menu-title logout-title">退出微信账号</text>
    <text class="menu-arrow">›</text>
  </view>

  <view class="version-wrap" bindtap="onVersionTap">
    <text class="version-text">赣南健康城 v{{appVersion}}</text>
  </view>

  <tab-bar active="mine" />
</view>
