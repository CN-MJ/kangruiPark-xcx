<view class="page-wrap">
  <view class="card">
    <view class="card-title">重置密码</view>
    <text class="bind-tip">通过短信验证后设置新密码</text>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="form-field">
        <input class="form-input" type="number" maxlength="11" placeholder="请输入注册手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <view class="form-field code-field">
          <input class="form-input" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" />
        </view>
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">新密码</text>
      <view class="form-field">
        <input class="form-input" password placeholder="至少6位" value="{{password}}" bindinput="onPasswordInput" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">确认新密码</text>
      <view class="form-field">
        <input class="form-input" password placeholder="再次输入新密码" value="{{passwordConfirm}}" bindinput="onConfirmInput" />
      </view>
    </view>

    <text class="dev-hint" wx:if="{{devHint}}">{{devHint}}</text>

    <view class="action-btn action-btn-primary {{submitting ? 'is-loading' : ''}}" bindtap="onSubmit">
      <text class="action-btn-text">确认重置</text>
    </view>
  </view>
</view>
