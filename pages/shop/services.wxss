@import "../merchant/services.wxss";

.svc-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #eef2f7;
}

.form-tip {
  display: block;
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef2f7;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(15, 23, 42, 0.65);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  box-sizing: border-box;
}

.image-add-text {
  font-size: 48rpx;
  color: #94a3b8;
  line-height: 1;
}
