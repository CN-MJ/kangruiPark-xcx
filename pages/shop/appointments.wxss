page {
  --primary: #003791;
  background: #f2f5fa;
}

.appt-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.appt-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 20rpx 24rpx 8rpx;
  background: linear-gradient(180deg, #f2f5fa 72%, rgba(242, 245, 250, 0.92));
}

.appt-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.appt-summary-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.appt-summary-sub {
  font-size: 22rpx;
  color: #94a3b8;
}

.appt-tabs {
  width: 100%;
  white-space: nowrap;
}

.appt-tabs-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 2rpx 12rpx;
}

.appt-tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #64748b;
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 40, 100, 0.06);
}

.appt-tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.appt-list {
  padding: 8rpx 24rpx 0;
}

.appt-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 40, 100, 0.08);
}

.appt-card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.appt-card-titles {
  flex: 1;
  min-width: 0;
}

.appt-service {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.appt-ent {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.appt-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.appt-status.tone-pending {
  color: #b45309;
  background: #fff7ed;
}

.appt-status.tone-ok {
  color: #047857;
  background: #ecfdf5;
}

.appt-status.tone-reject {
  color: #b91c1c;
  background: #fef2f2;
}

.appt-status.tone-muted {
  color: #64748b;
  background: #f1f5f9;
}

.appt-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.appt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.appt-label {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #94a3b8;
}

.appt-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.4;
}

.appt-value.strong {
  color: #0f172a;
  font-weight: 600;
}

.appt-value.muted {
  color: #94a3b8;
  font-size: 24rpx;
}

.appt-card-hover {
  opacity: 0.92;
  transform: scale(0.995);
}

.appt-row-phone {
  align-items: center;
}

.appt-phone-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.appt-call {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  background: #eef3fb;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.appt-more {
  margin-top: 18rpx;
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
}

.appt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 4rpx;
}

.appt-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.appt-btn.ghost {
  background: #fff1f0;
  color: #cf1322;
}

.appt-btn.primary {
  background: var(--primary);
  color: #fff;
}

.appt-loading,
.appt-empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.appt-loading {
  font-size: 28rpx;
  color: #94a3b8;
}

.appt-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #64748b;
}

.appt-empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
