@import "./appointments.wxss";

.detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 40, 100, 0.08);
}

.detail-hero-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-service {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.detail-ent {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.detail-price {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0d9488;
}

.detail-summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.detail-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 40, 100, 0.08);
}

.detail-section {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 12rpx 0;
}

.detail-label {
  width: 128rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #94a3b8;
}

.detail-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.45;
}

.detail-value.strong {
  color: #0f172a;
  font-weight: 700;
}

.detail-call-btn {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #eef3fb;
  color: #003791;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(15, 40, 100, 0.08);
}

.detail-safe {
  height: 140rpx;
}
