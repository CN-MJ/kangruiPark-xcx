<view class="appt-page">
  <view class="appt-sticky">
    <view class="appt-summary" wx:if="{{!loading}}">
      <text class="appt-summary-text">待处理 {{pendingCount}} 条</text>
      <text class="appt-summary-sub">共 {{list.length}} 条记录</text>
    </view>
    <scroll-view class="appt-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="appt-tabs-row">
        <view
          class="appt-tab {{filter === item.key ? 'active' : ''}}"
          wx:for="{{filters}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onFilter"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="appt-loading" wx:if="{{loading}}">加载中...</view>

  <view class="appt-list" wx:elif="{{displayList.length}}">
    <view
      class="appt-card"
      wx:for="{{displayList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onDetail"
      hover-class="appt-card-hover"
    >
      <view class="appt-card-head">
        <view class="appt-card-titles">
          <text class="appt-service">{{item.serviceName}}</text>
          <text class="appt-ent" wx:if="{{item.enterpriseName}}">{{item.enterpriseName}}</text>
        </view>
        <text class="appt-status {{item.statusTone}}">{{item.status_text}}</text>
      </view>

      <view class="appt-info">
        <view class="appt-row">
          <text class="appt-label">访客</text>
          <text class="appt-value">{{item.user_name || '—'}}</text>
        </view>
        <view class="appt-row appt-row-phone">
          <text class="appt-label">手机</text>
          <view class="appt-phone-wrap">
            <text class="appt-value">{{item.user_phone || '—'}}</text>
            <view
              class="appt-call"
              wx:if="{{item.user_phone}}"
              data-phone="{{item.user_phone}}"
              catchtap="onCall"
            >拨打</view>
          </view>
        </view>
        <view class="appt-row">
          <text class="appt-label">时间</text>
          <text class="appt-value strong">{{item.timeText}}</text>
        </view>
        <view class="appt-row" wx:if="{{item.created_at}}">
          <text class="appt-label">提交</text>
          <text class="appt-value muted">{{item.created_at}}</text>
        </view>
      </view>

      <view class="appt-actions" wx:if="{{item.status === 0}}" catchtap="noop">
        <view
          class="appt-btn ghost"
          data-id="{{item.id}}"
          data-action="reject"
          catchtap="onAction"
        >拒绝</view>
        <view
          class="appt-btn primary"
          data-id="{{item.id}}"
          data-action="confirm"
          catchtap="onAction"
        >确认预约</view>
      </view>
      <view class="appt-more" wx:else>查看详情 ›</view>
    </view>
  </view>

  <view class="appt-empty" wx:elif="{{!loading}}">
    <text class="appt-empty-title">暂无预约</text>
    <text class="appt-empty-desc">{{filter === 'pending' ? '当前没有待确认的预约' : '切换筛选或稍后再看'}}</text>
  </view>
</view>
