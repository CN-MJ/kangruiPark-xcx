.page-wrap {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: #f5f7fb;
}

.empty-card {
  padding: 72rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.empty-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #888;
  line-height: 1.7;
}
