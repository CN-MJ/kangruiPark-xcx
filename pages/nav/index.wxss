.place-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.place-item:last-child {
  border-bottom: none;
}

.place-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.place-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx;
}
