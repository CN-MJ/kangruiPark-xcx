page { background: #f6f7fb; }

.forgot-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #0047b3;
}

.login-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.captcha-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.captcha-input {
  flex: 1;
}

.captcha-img {
  width: 220rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #eef3fb;
  flex-shrink: 0;
}
