<view class="page-wrap">
  <view class="card">
    <view class="card-title">商户登录</view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" bindinput="onPhoneInput" placeholder="请输入商户联系人手机号" />
    </view>
    <view class="form-item">
      <text class="form-label">登录密码</text>
      <input class="form-input" password bindinput="onPasswordInput" placeholder="请输入登录密码" />
    </view>
    <view class="action-btn action-btn-primary {{loading ? 'is-loading' : ''}}" bindtap="onSubmit">
      <text class="action-btn-text">登录</text>
    </view>
    <view class="forgot-link" bindtap="onForgotPassword">忘记密码？</view>
    <text class="login-tip">测试：13800001001 / 密码 123456</text>
  </view>
</view>
