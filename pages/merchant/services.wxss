@import "./home.wxss";

.form-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.form-sheet {
  width: 100%;
  max-height: 88vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.form-sheet-head {
  flex-shrink: 0;
  padding: 28rpx 28rpx 8rpx;
}

.form-sheet-head .card-title {
  margin-bottom: 0;
}

.form-sheet-body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.form-body-spacer {
  height: 24rpx;
}

.form-sheet-foot {
  flex-shrink: 0;
  padding: 16rpx 28rpx 24rpx;
  border-top: 1rpx solid #eef2f7;
  background: #fff;
}

.form-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-status-row .form-label {
  margin-bottom: 0;
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
}

.status-toggle {
  min-width: 168rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.status-toggle.on {
  background: #ecfdf5;
  color: #047857;
}

.status-toggle.off {
  background: #f1f5f9;
  color: #64748b;
}

.form-actions {
  display: flex;
  gap: 16rpx;
}

.form-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.form-btn.ghost {
  background: #eef3fb;
  color: #003791;
}

.form-btn.primary {
  background: #003791;
  color: #fff;
}

.form-item {
  margin-top: 24rpx;
}

.form-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 160rpx;
}

.action-btn-sm.primary {
  background: #003791;
}

.action-btn-sm.primary .action-btn-sm-text {
  color: #fff;
}

.empty-tip {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.svc-cover {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #eef2f7;
}

.form-tip {
  display: block;
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item,
.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef2f7;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(15, 23, 42, 0.65);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  box-sizing: border-box;
}

.image-add-text {
  font-size: 48rpx;
  color: #94a3b8;
  line-height: 1;
}
