<view class="page-wrap">
  <view class="card">
    <view class="card-title">招商意向登记</view>
    <view class="form-item"><text class="form-label">公司名称</text><input class="form-input" data-key="company_name" bindinput="onInput" placeholder="请输入公司名称" /></view>
    <view class="form-item"><text class="form-label">联系人</text><input class="form-input" data-key="contact_name" bindinput="onInput" placeholder="请输入联系人" /></view>
    <view class="form-item"><text class="form-label">手机号</text><input class="form-input" data-key="contact_phone" bindinput="onInput" placeholder="请输入手机号" /></view>
    <view class="form-item"><text class="form-label">需求面积</text><input class="form-input" data-key="demand_area" bindinput="onInput" placeholder="如 200-500㎡" /></view>
    <view class="form-item">
      <text class="form-label">意向房源</text>
      <picker mode="selector" range="{{houseTitles}}" value="{{houseIndex}}" bindchange="onHouseChange">
        <view class="form-picker">{{houseTitles[houseIndex]}}</view>
      </picker>
    </view>
    <view class="form-item"><text class="form-label">备注</text><input class="form-input" data-key="message" bindinput="onInput" placeholder="选填" /></view>
    <view class="action-btn action-btn-primary" bindtap="onSubmit"><text class="action-btn-text">提交</text></view>
  </view>
</view>
