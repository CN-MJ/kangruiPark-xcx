.house-detail {
  --tone-blue: #1f6feb;
  --tone-red: #c23b3b;
  --tone-yellow: #c9a227;
  --tone-gray: #6b7280;
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f5f7fb 0%, #eef2f7 100%);
}

.house-detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(20, 32, 51, 0.06);
}

.house-detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.house-detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #142033;
}

.house-detail-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.house-detail-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  white-space: nowrap;
}

.house-detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.house-detail-cell {
  width: calc((100% - 18rpx) / 2);
  padding: 22rpx 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.house-detail-cell-full {
  width: 100%;
}

.house-detail-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.house-detail-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #142033;
}

.tone-blue { background: var(--tone-blue); }
.tone-red { background: var(--tone-red); }
.tone-yellow { background: var(--tone-yellow); color: #1f2937; }
.tone-gray { background: var(--tone-gray); }
