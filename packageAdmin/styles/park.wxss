/* 园区工作台公共样式 */
.park-page {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
}

.park-hero {
  margin: 0 -24rpx 24rpx;
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(145deg, #5b8cff 0%, #3b66f5 55%, #2f55e0 100%);
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(59, 102, 245, 0.28);
}

.park-hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.park-hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.park-hero-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.park-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.park-stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 35, 95, 0.1);
  position: relative;
  overflow: hidden;
}

.park-stat-card::after {
  content: '';
  position: absolute;
  right: -16rpx;
  top: -16rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  opacity: 0.12;
}

.park-stat-card.blue::after { background: #3b66f5; }
.park-stat-card.green::after { background: #52c41a; }
.park-stat-card.orange::after { background: #fa8c16; }
.park-stat-card.purple::after { background: #722ed1; }

.park-stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.park-stat-num.blue { color: #3b66f5; }
.park-stat-num.green { color: #52c41a; }
.park-stat-num.orange { color: #fa8c16; }
.park-stat-num.purple { color: #722ed1; }

.park-stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.park-section-title {
  display: block;
  margin: 8rpx 0 16rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.park-menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.park-menu-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 35, 95, 0.1);
}

.park-menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 36rpx;
}

.park-menu-icon-wrap.blue { background: rgba(59, 102, 245, 0.12); }
.park-menu-icon-wrap.green { background: rgba(82, 196, 26, 0.12); }
.park-menu-icon-wrap.orange { background: rgba(250, 140, 22, 0.12); }
.park-menu-icon-wrap.purple { background: rgba(114, 46, 209, 0.12); }

.park-menu-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.park-menu-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.4;
}

.park-filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 0;
  overflow-x: auto;
}

.park-filter-tab {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.park-filter-tab.active {
  color: #fff;
  background: #3b66f5;
  font-weight: 500;
}

.park-search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 95, 0.08);
}

.park-search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
}

.park-search-icon {
  font-size: 28rpx;
  color: #bbb;
  margin-right: 12rpx;
}

.park-list-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 35, 95, 0.1);
}

.park-list-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.park-list-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.park-list-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.park-list-meta .highlight {
  color: #3b66f5;
}

.park-btn-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.park-summary-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.park-summary-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 35, 95, 0.08);
}

.park-summary-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #3b66f5;
}

.park-summary-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.park-loading {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #bbb;
}

.park-empty {
  text-align: center;
  padding: 100rpx 40rpx;
}

.park-empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.park-empty-text {
  font-size: 28rpx;
  color: #999;
}

.park-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b8cff, #3b66f5);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(59, 102, 245, 0.4);
  z-index: 10;
}
