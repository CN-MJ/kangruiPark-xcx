<view class="park-page">
  <view class="action-btn action-btn-primary" bindtap="onCreate"><text class="action-btn-text">新增政策</text></view>
  <view class="park-list-card" wx:for="{{list}}" wx:key="id">
    <text class="park-list-title">{{item.title}}</text>
    <text class="park-list-meta">{{item.level}}</text>
    <text class="park-list-meta">展示：{{item.is_show ? '是' : '否'}}</text>
    <view class="park-btn-row">
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onEdit"><text class="action-btn-sm-text">编辑</text></view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" bindtap="onDelete"><text class="action-btn-sm-text danger">删除</text></view>
    </view>
  </view>
  <view class="park-empty" wx:if="{{!loading && list.length===0}}">暂无政策</view>
  <view class="park-loading" wx:if="{{loading}}">加载中...</view>
</view>
