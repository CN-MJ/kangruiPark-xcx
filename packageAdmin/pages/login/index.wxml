<view class="login-page">
  <view class="login-hero">
    <view class="login-hero-inner">
      <view class="login-logo">
        <text class="login-logo-icon">🏛</text>
      </view>
      <view class="login-title">园区工作台</view>
      <view class="login-sub">需先微信授权 · 再用园区账号密码登录</view>
      <view class="login-features">
        <view class="feature-tag">健康企业汇</view>
        <view class="feature-tag">类型配置</view>
        <view class="feature-tag">新闻预约</view>
      </view>
    </view>
  </view>

  <view class="login-body">
    <view class="login-card">
      <view class="form-item">
        <view class="form-label">手机号</view>
        <view class="form-field">
          <input
            class="form-input login-input"
            type="number"
            maxlength="11"
            placeholder="请输入园区人员手机号"
            placeholder-class="form-placeholder"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">登录密码</view>
        <view class="form-field">
          <input
            class="form-input login-input"
            password
            placeholder="请输入登录密码"
            placeholder-class="form-placeholder"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">图形验证码</view>
        <view class="captcha-row">
          <view class="form-field captcha-field">
            <input
              class="form-input login-input"
              maxlength="6"
              placeholder="请输入验证码"
              placeholder-class="form-placeholder"
              value="{{captchaCode}}"
              bindinput="onCaptchaInput"
            />
          </view>
          <image
            class="captcha-img"
            src="{{captchaImage}}"
            mode="aspectFit"
            bindtap="refreshCaptcha"
          ></image>
        </view>
      </view>
      <view class="action-btn action-btn-primary {{loading ? 'is-loading' : ''}}" bindtap="onLogin">
        <view wx:if="{{loading}}" class="action-btn-spinner"></view>
        <text class="action-btn-text">进入工作台</text>
      </view>
      <view class="forgot-link" bindtap="onForgotPassword">忘记密码？</view>
    </view>

    <view class="login-tip">密码丢失请联系系统管理员重置。验证码点右侧图片可刷新。</view>
  </view>
</view>
