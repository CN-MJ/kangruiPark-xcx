.login-page {
  min-height: 100vh;
  background: #f4f6f8;
  box-sizing: border-box;
}

.login-hero {
  padding: 48rpx 32rpx 72rpx;
  background: linear-gradient(145deg, #5b8cff 0%, #3b66f5 55%, #2f55e0 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(59, 102, 245, 0.3);
}

.login-hero-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-logo-icon {
  font-size: 56rpx;
  line-height: 1;
}

.login-title {
  width: 100%;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.login-sub {
  width: 100%;
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.4;
}

.login-features {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
}

.feature-tag {
  margin: 0 8rpx 12rpx;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.login-body {
  padding: 0 24rpx;
  margin-top: -44rpx;
  position: relative;
  z-index: 1;
}

.login-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 35, 95, 0.12);
}

.login-card .form-label {
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.login-input {
  height: 88rpx;
  line-height: normal;
}

.login-card .action-btn-primary {
  margin-top: 36rpx;
}

.login-tip {
  width: 100%;
  margin-top: 36rpx;
  padding-bottom: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.5;
}
