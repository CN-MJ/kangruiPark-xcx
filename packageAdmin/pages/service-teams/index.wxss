@import "../../styles/park.wxss";

.st-search {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.st-search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
}

.st-search-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #003791;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.st-card {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.st-avatar {
  width: 120rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.st-main {
  flex: 1;
  min-width: 0;
}
