.st-photo-box {
  width: 220rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  border: 1rpx dashed #cbd5e1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-photo-box--press {
  opacity: 0.85;
}

.st-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.st-photo-placeholder-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
}

.st-photo-placeholder {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.st-photo-placeholder-sub {
  font-size: 22rpx;
  color: #94a3b8;
}

.st-photo-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1f6feb;
  line-height: 1.4;
}
