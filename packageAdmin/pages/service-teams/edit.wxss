.st-photo-box {
  width: 200rpx;
  height: 250rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  border: 1rpx dashed #cbd5e1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-photo {
  width: 100%;
  height: 100%;
}

.st-photo-placeholder {
  font-size: 24rpx;
  color: #94a3b8;
}
