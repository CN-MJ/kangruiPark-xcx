.page-wrap { padding: 24rpx; padding-bottom: 80rpx; }
.empty-tip { padding: 60rpx; text-align: center; color: #94a3b8; }
.form-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15,23,42,.45); z-index: 99;
  display: flex; align-items: flex-end;
}
.form-sheet {
  width: 100%; max-height: 85vh; overflow-y: auto;
  border-radius: 24rpx 24rpx 0 0; margin: 0;
}
.form-item { margin-top: 20rpx; }
.form-label { font-size: 24rpx; color: #64748b; display: block; margin-bottom: 8rpx; }
.form-input, .form-textarea {
  width: 100%; box-sizing: border-box; padding: 16rpx 20rpx;
  background: #f8fafc; border-radius: 12rpx; font-size: 28rpx;
}
.form-textarea { min-height: 140rpx; }
