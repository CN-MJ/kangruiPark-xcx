<view class="park-page">
  <view class="action-btn action-btn-primary" bindtap="onCreate">
    <text class="action-btn-text">新增活动</text>
  </view>

  <picker mode="selector" range="{{statusTabs}}" value="{{statusFilterIndex}}" bindchange="onStatusFilter">
    <view class="park-filter-tab active" style="display:inline-block;margin-bottom:20rpx;">
      状态：{{statusTabs[statusFilterIndex]}}
    </view>
  </picker>

  <view class="park-list-card" wx:for="{{list}}" wx:key="id">
    <view class="park-list-head-row">
      <text class="park-list-title">{{item.title}}</text>
      <text class="park-status-tag {{item.statusClass}}">{{item.statusText}}</text>
    </view>
    <text class="park-list-meta">时间：{{item.timeText}}</text>
    <text class="park-list-meta">地点：{{item.location}}</text>
    <text class="park-list-meta">报名：<text class="highlight">{{item.attendeesText}}</text></text>
    <view class="park-btn-row">
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onRegistrations">
        <text class="action-btn-sm-text">报名名单</text>
      </view>
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onEdit">
        <text class="action-btn-sm-text">编辑</text>
      </view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onDelete">
        <text class="action-btn-sm-text danger">删除</text>
      </view>
    </view>
  </view>

  <view class="park-empty" wx:if="{{!loading && list.length===0}}">
    <text class="park-empty-text">暂无活动</text>
  </view>
  <view class="park-loading" wx:if="{{loading}}">加载中...</view>
</view>
