<view class="park-page">
  <view class="park-search-bar">
    <view class="park-search-icon">
      <kr-icon name="search" size="32" color="#94a3b8" />
    </view>
    <input
      class="park-search-input"
      placeholder="搜索手机号"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <text class="search-btn" bindtap="onSearch" wx:if="{{keyword}}">搜索</text>
    <text class="search-btn clear" bindtap="onClearSearch" wx:if="{{keyword}}">清除</text>
  </view>

  <view class="park-filter-bar">
    <view
      class="park-filter-tab {{activeFilter === item.key ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >{{item.label}}</view>
  </view>

  <view class="park-loading" wx:if="{{loading}}">加载中...</view>

  <view class="park-list-card" wx:for="{{list}}" wx:key="id">
    <view class="park-list-head">
      <text class="park-list-title">{{item.displayTitle}}</text>
      <text class="tag {{item.status === 1 ? 'tag-active' : 'tag-cancelled'}}">{{item.statusText}}</text>
    </view>
    <text class="park-list-meta" wx:if="{{item.locationText}}">位置：{{item.locationText}}</text>
    <text class="park-list-meta">
      <text class="highlight">{{item.user_name}}</text> · {{item.user_phone}}
    </text>
    <text class="park-list-meta">预约时间：{{item.timeText}}</text>
    <view class="park-btn-row" wx:if="{{item.status === 0}}">
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onConfirm">
        <text class="action-btn-sm-text">确认</text>
      </view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" bindtap="onReject">
        <text class="action-btn-sm-text danger">拒绝</text>
      </view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" bindtap="onCancel">
        <text class="action-btn-sm-text danger">取消预约</text>
      </view>
    </view>
  </view>

  <view class="park-empty" wx:if="{{!loading && list.length === 0}}">
    <view class="park-empty-icon">
      <kr-icon name="order" size="64" color="#cbd5e1" />
    </view>
    <text class="park-empty-text">暂无预约记录</text>
  </view>
</view>
