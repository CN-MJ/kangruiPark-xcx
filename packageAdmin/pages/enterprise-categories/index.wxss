@import '../../styles/park.wxss';

page { background: #f4f6f8; }

.cat-page {
  padding-bottom: 48rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.toolbar-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: #fff;
  color: #003791;
  box-shadow: 0 6rpx 18rpx rgba(15, 40, 100, 0.06);
}

.toolbar-btn.primary {
  background: #003791;
  color: #fff;
  font-weight: 600;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 40, 100, 0.08);
}

.form-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.form-hint {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #64748b;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item--half {
  flex: 1;
  min-width: 0;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn-sm.primary { background: #003791; }
.action-btn-sm-text.primary { color: #fff; }

.major-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 40, 100, 0.08);
}

.major-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.major-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #eef3fb;
  color: #003791;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.major-title-wrap {
  flex: 1;
  min-width: 0;
}

.major-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
}

.major-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.expand-icon {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #003791;
  padding-top: 6rpx;
}

.minor-list {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #e2e8f0;
}

.minor-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.minor-item:last-child {
  border-bottom: none;
}

.minor-main {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.minor-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3d6fd4;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.minor-name {
  flex: 1;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.45;
}

.park-empty.compact {
  padding: 24rpx 0;
}
