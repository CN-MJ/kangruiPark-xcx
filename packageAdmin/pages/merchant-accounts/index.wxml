<view class="page-wrap">
  <view class="card">
    <view class="card-title">绑定企业工作台</view>
    <text class="order-meta" wx:if="{{enterpriseName}}">企业：{{enterpriseName}}</text>
    <view class="form-item">
      <text class="form-label">登录手机号</text>
      <input class="form-input" type="number" data-field="contact_phone" value="{{contact_phone}}" bindinput="onField" />
    </view>
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-input" data-field="contact_name" value="{{contact_name}}" bindinput="onField" />
    </view>
    <view class="form-item">
      <text class="form-label">初始密码（可选）</text>
      <input class="form-input" password data-field="password" value="{{password}}" bindinput="onField" placeholder="留空则用手机号后6位" />
    </view>
    <view class="action-btn action-btn-primary" bindtap="onBind">
      <text class="action-btn-text">{{submitting ? '提交中...' : '创建/绑定账号'}}</text>
    </view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="card-title">{{item.name}}</view>
    <text class="order-meta">手机：{{item.contact_phone}}</text>
    <text class="order-meta">联系人：{{item.contact_name || '-'}}</text>
    <text class="order-meta">服务号：{{item.has_mp_openid ? '已绑定' : '未绑定'}}</text>
  </view>

  <view class="empty-tip" wx:if="{{loading}}">加载中...</view>
  <view class="empty-tip" wx:elif="{{!list.length}}">尚未绑定工作台账号</view>
</view>
