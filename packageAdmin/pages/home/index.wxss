@import '../../styles/park.wxss';

.overview-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.overview-row:last-child {
  border-bottom: none;
}

.overview-item {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.overview-item .num {
  font-weight: 700;
  color: #3b66f5;
  margin-left: 8rpx;
}
