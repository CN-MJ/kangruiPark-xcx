<view class="park-page house-admin">
  <view class="action-btn action-btn-primary" bindtap="onCreate">
    <text class="action-btn-text">新增房源</text>
  </view>

  <view class="house-admin-filters">
    <picker mode="selector" range="{{leaseTabs}}" range-key="label" value="{{leaseFilterIndex}}" bindchange="onLeaseFilter">
      <view class="park-filter-tab active">租售：{{leaseTabs[leaseFilterIndex].label}}</view>
    </picker>
    <picker mode="selector" range="{{marketTabs}}" value="{{marketFilterIndex}}" bindchange="onMarketFilter">
      <view class="park-filter-tab active">上架：{{marketTabs[marketFilterIndex]}}</view>
    </picker>
  </view>

  <view class="park-list-card" wx:for="{{list}}" wx:key="id">
    <view class="park-list-head-row">
      <text class="park-list-title">{{item.displayTitle}}</text>
      <text class="house-tone-tag {{item.toneClass}}">{{item.lease_sale_text}}</text>
    </view>
    <text class="park-list-meta">{{item.metaText}}</text>
    <text class="park-list-meta">{{item.marketText}} · 排序 {{item.sort_order}} · 意向 {{item.intents_count || 0}} 条</text>
    <view class="park-btn-row">
      <view class="action-btn-sm" wx:if="{{item.intents_count > 0}}" data-id="{{item.id}}" data-title="{{item.displayTitle}}" bindtap="onViewIntents">
        <text class="action-btn-sm-text">查看意向</text>
      </view>
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onEdit">
        <text class="action-btn-sm-text">编辑</text>
      </view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" bindtap="onDelete">
        <text class="action-btn-sm-text danger">删除</text>
      </view>
    </view>
  </view>

  <view class="park-empty" wx:if="{{!loading && list.length===0}}">
    <text class="park-empty-text">暂无房源</text>
  </view>
  <view class="park-loading" wx:if="{{loading}}">加载中...</view>
</view>
