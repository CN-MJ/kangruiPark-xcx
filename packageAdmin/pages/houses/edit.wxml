<view class="page-wrap edit-page">
  <view class="preview-card">
    <view class="preview-main">
      <text class="preview-title">{{previewTitle}}</text>
      <text class="preview-sub">{{previewSub}}</text>
    </view>
    <view class="preview-badge tone-{{leaseTone}}">{{leaseOptions[leaseIndex].label}}</view>
  </view>

  <view class="card">
    <text class="section-title">位置与面积</text>

    <view class="form-row">
      <view class="form-item form-item--half">
        <text class="form-label">栋号 <text class="req">*</text></text>
        <view class="form-field">
          <input
            class="form-input"
            data-key="building_no"
            value="{{building_no}}"
            bindinput="onInput"
            placeholder="如 17"
          />
        </view>
        <text class="form-tip">不用写「栋」</text>
      </view>
      <view class="form-item form-item--half">
        <text class="form-label">房号 <text class="req">*</text></text>
        <view class="form-field">
          <input
            class="form-input"
            data-key="room_no"
            value="{{room_no}}"
            bindinput="onInput"
            placeholder="如 101"
          />
        </view>
      </view>
    </view>

    <view class="form-row">
      <view class="form-item form-item--half">
        <text class="form-label">层数 <text class="req">*</text></text>
        <view class="form-field">
          <input
            class="form-input"
            type="number"
            data-key="floor"
            value="{{floor}}"
            bindinput="onInput"
            placeholder="负一层填 -1"
          />
        </view>
      </view>
      <view class="form-item form-item--half">
        <text class="form-label">层高（米）</text>
        <view class="form-field">
          <input
            class="form-input"
            type="digit"
            data-key="floor_height"
            value="{{floor_height}}"
            bindinput="onInput"
            placeholder="如 3.6"
          />
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">建筑面积（㎡） <text class="req">*</text></text>
      <view class="form-field">
        <input
          class="form-input"
          type="digit"
          data-key="building_area"
          value="{{building_area}}"
          bindinput="onInput"
          placeholder="如 302.06"
        />
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">租售状态</text>
    <text class="form-tip section-tip">点选颜色状态，与访客端色块一致</text>
    <view class="lease-grid">
      <view
        class="lease-chip tone-{{item.tone}} {{lease_sale_status === item.value ? 'is-on' : ''}}"
        wx:for="{{leaseOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        data-index="{{index}}"
        bindtap="onLeaseTap"
      >
        <text class="lease-chip-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">上架与排序</text>

    <view class="form-item form-item--switch">
      <view class="switch-copy">
        <text class="form-label form-label--inline">上架展示</text>
        <text class="form-tip">关闭后访客端不可见</text>
      </view>
      <switch checked="{{status === 1}}" color="#1f6feb" bindchange="onMarketSwitch" />
    </view>

    <view class="form-item">
      <text class="form-label">排序值</text>
      <view class="form-field">
        <input
          class="form-input"
          type="number"
          data-key="sort_order"
          value="{{sort_order}}"
          bindinput="onInput"
          placeholder="数字越大越靠前"
        />
      </view>
    </view>

    <view class="intent-link" wx:if="{{id && intents_count > 0}}" bindtap="onViewIntents">
      该房源有 <text class="highlight">{{intents_count}}</text> 条招商意向，点击查看
    </view>
  </view>

  <view class="save-spacer"></view>

  <view class="save-bar">
    <view class="action-btn action-btn-primary {{submitting ? 'is-loading' : ''}}" bindtap="onSubmit">
      <text class="action-btn-text">{{submitting ? '保存中…' : '保存房源'}}</text>
    </view>
  </view>
</view>
