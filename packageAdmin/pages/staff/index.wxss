.page {
  padding: 16rpx 20rpx 32rpx;
  background: #f4f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.search-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.search-btn {
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #003791;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.filter-row {
  display: inline-flex;
  gap: 10rpx;
}

.filter-chip {
  padding: 8rpx 18rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #475569;
}

.filter-chip.on {
  background: #003791;
  color: #fff;
}

.filter-picker {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #003791;
}

.user-row {
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  background: #fff;
  border-radius: 12rpx;
}

.user-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-phone {
  flex: 1;
  font-size: 24rpx;
  color: #64748b;
}

.mini-tag {
  font-size: 20rpx;
  color: #b45309;
  background: #ffedd5;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.mini-tag.warn {
  color: #9a3412;
}

.user-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.user-ops {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #003791;
  font-size: 22rpx;
  line-height: 1.6;
}

.chip.need {
  background: #fff7ed;
  color: #c2410c;
}

.chip.ghost {
  background: #f1f5f9;
  color: #475569;
}

.chip.ok {
  background: #003791;
  color: #fff;
}

.chip.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.switch-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  font-size: 22rpx;
  color: #64748b;
}

.park-empty,
.park-loading {
  text-align: center;
  padding: 32rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.sheet-item {
  padding: 26rpx 8rpx;
  border-top: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  color: #0f172a;
}
