.page {
  padding: 16rpx 20rpx 32rpx;
  background: #f4f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.hint-card {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  background: #fffbeb;
  border-radius: 12rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.45;
}

.add-btn {
  display: inline-block;
  margin-bottom: 12rpx;
  margin-right: 12rpx;
  padding: 8rpx 22rpx;
  background: #003791;
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.add-btn.ghost {
  background: #e2e8f0;
  color: #334155;
}

.role-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  padding: 14rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.role-main {
  flex: 1;
  min-width: 0;
}

.role-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.role-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #003791;
  padding: 8rpx 4rpx;
}

.row-link.danger {
  color: #b91c1c;
}

.editor {
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.editor-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.name-input {
  margin: 12rpx 0;
  height: 64rpx;
  padding: 0 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #0f172a;
}

.editor-ops {
  display: flex;
  margin-top: 12rpx;
}

.park-empty,
.park-loading {
  text-align: center;
  padding: 32rpx 0;
  color: #94a3b8;
  font-size: 24rpx;
}
