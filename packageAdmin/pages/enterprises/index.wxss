@import '../../styles/park.wxss';

page { background: #f4f6f8; }

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.search-btn {
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #003791;
  color: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.park-list-head-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.park-list-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e2e8f0;
}

.park-list-head-main {
  flex: 1;
  min-width: 0;
}

.park-list-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.park-list-scope {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.park-status-tag.ok {
  color: #059669;
  background: #ecfdf5;
}

.park-status-tag.off {
  color: #64748b;
  background: #f1f5f9;
}
