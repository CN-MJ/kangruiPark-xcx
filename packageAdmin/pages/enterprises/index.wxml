<view class="park-page">
  <view class="action-btn action-btn-primary" bindtap="onCreate">
    <text class="action-btn-text">录入企业</text>
  </view>

  <view class="search-row">
    <input
      class="search-input"
      placeholder="搜索企业 / 联系人 / 业务"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="park-list-card" wx:for="{{list}}" wx:key="id">
    <view class="park-list-head-row">
      <image wx:if="{{item.cover}}" class="park-list-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="park-list-head-main">
        <view class="park-list-title-row">
          <text class="park-list-title">{{item.name}}</text>
          <text class="park-status-tag {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="park-list-meta">{{item.primary_category.name || '-'}} · {{item.service_audience_text}}</text>
      </view>
    </view>
    <text class="park-list-meta">{{item.district || '未识别县区'}} · {{item.source_text}} · {{item.settleText}}</text>
    <text class="park-list-meta" wx:if="{{item.tagsText}}">小类：{{item.tagsText}}</text>
    <text class="park-list-meta park-list-scope">{{item.business_intro}}</text>
    <view class="park-btn-row">
      <view class="action-btn-sm" data-id="{{item.id}}" bindtap="onEdit">
        <text class="action-btn-sm-text">编辑</text>
      </view>
      <view class="action-btn-sm danger" data-id="{{item.id}}" bindtap="onDelete">
        <text class="action-btn-sm-text danger">删除</text>
      </view>
    </view>
  </view>

  <view class="park-empty" wx:if="{{!loading && list.length===0}}">
    <text class="park-empty-text">暂无企业，请先配置类型后录入</text>
  </view>
  <view class="park-loading" wx:if="{{loading}}">加载中...</view>
</view>
