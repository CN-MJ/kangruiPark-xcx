page { background: #f4f6f8; }

.edit-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.req {
  color: #dc2626;
  font-weight: 600;
}

.form-tip {
  display: block;
  margin: -8rpx 0 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.form-label--inline {
  margin-bottom: 4rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item--half {
  flex: 1;
  min-width: 0;
}

.form-item--switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.address-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.address-field {
  flex: 1;
  min-width: 0;
}

.loc-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #eef3fb;
  color: #003791;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  max-width: 100%;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.35;
}

.chip.active {
  background: #e8f0ff;
  color: #003791;
  font-weight: 600;
}

.chip-empty {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 12rpx 0;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
}

.image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.75);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.image-add-text {
  color: #64748b;
  font-size: 48rpx;
  line-height: 1;
}

.save-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.save-panel {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.save-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  text-align: center;
  margin-bottom: 28rpx;
}

.save-bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.save-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #003791;
  transition: width 0.2s ease;
}

.save-percent {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #003791;
  font-weight: 600;
}

.save-detail {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
}
