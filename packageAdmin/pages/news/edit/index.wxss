@import '../../../styles/park.wxss';

.edit-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.edit-card {
  margin-bottom: 20rpx;
}

.edit-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.cover-upload {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 2rpx dashed #d9d9d9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.cover-change {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.cover-plus {
  font-size: 64rpx;
  color: #ccc;
  line-height: 1;
}

.cover-tip {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.cover-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.cover-remove {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #cf1322;
}

.edit-textarea {
  min-height: 360rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-item .form-label {
  margin-bottom: 4rpx;
}

.switch-desc {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

.edit-actions {
  margin-top: 8rpx;
  padding-bottom: 24rpx;
}

.edit-actions .action-btn-plain {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.edit-actions .action-btn-primary {
  margin-top: 0;
}

.type-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.type-picker-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1;
}

.type-picker-arrow {
  font-size: 32rpx;
  color: #ccc;
  line-height: 1;
}

.type-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #fa8c16;
  line-height: 1.5;
}
