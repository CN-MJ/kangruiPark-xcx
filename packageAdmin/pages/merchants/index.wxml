<view class="park-page">
  <view class="park-summary-bar" wx:if="{{stats}}">
    <view class="park-summary-item">
      <text class="park-summary-num">{{stats.merchants}}</text>
      <text class="park-summary-label">入驻商户</text>
    </view>
    <view class="park-summary-item">
      <text class="park-summary-num visitor">{{stats.visitors}}</text>
      <text class="park-summary-label">访客</text>
    </view>
    <view class="park-summary-item">
      <text class="park-summary-num checkin">{{stats.todayCheckins}}</text>
      <text class="park-summary-label">今日签到</text>
    </view>
  </view>

  <view class="park-search-bar">
    <view class="park-search-icon">
      <kr-icon name="search" size="32" color="#94a3b8" />
    </view>
    <input
      class="park-search-input"
      placeholder="搜索姓名或手机号"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <text class="search-btn" bindtap="onSearch" wx:if="{{keyword}}">搜索</text>
    <text class="search-btn clear" bindtap="onClearSearch" wx:if="{{keyword}}">清除</text>
  </view>

  <view class="park-filter-bar">
    <view
      class="park-filter-tab {{activeFilter === item.key ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >{{item.label}}</view>
  </view>

  <view class="park-loading" wx:if="{{loading}}">加载中...</view>

  <view class="park-list-card user-card" wx:for="{{list}}" wx:key="id">
    <view class="user-avatar">{{item.avatarChar}}</view>
    <view class="user-info">
      <view class="park-list-head">
        <text class="park-list-title">{{item.name}}</text>
        <text class="tag {{item.role === 'merchant' ? 'tag-active' : ''}}">{{item.role_text}}</text>
      </view>
      <text class="park-list-meta">{{item.phone}}</text>
      <text class="park-list-meta" wx:if="{{item.role === 'merchant'}}">签到时间：{{item.checkinText}}</text>
    </view>
  </view>

  <view class="park-empty" wx:if="{{!loading && list.length === 0}}">
    <view class="park-empty-icon">
      <kr-icon name="merchants" size="64" color="#cbd5e1" />
    </view>
    <text class="park-empty-text">暂无人员记录</text>
  </view>
</view>
